header.header

  // =========================================================
  // HEADER TOP
  // =========================================================

  .header-top

    .container

      .header-contact

        if website && website.phone

          a.contact-item(
            href="tel:" + website.phone
          )
            i.fas.fa-phone
            span= website.phone


        if website && website.email

          a.contact-item(
            href="mailto:" + website.email
          )
            i.fas.fa-envelope
            span= website.email


        if website && website.address

          span.contact-item

            i.fas.fa-map-marker-alt

            span= website.address


  // =========================================================
  // HEADER MAIN
  // =========================================================

  .header-main

    .container.header-inner


      // =======================================================
      // NÚT 3 SỌC
      // =======================================================

      button.menu-toggle(
        type="button"
        aria-label="Menu"
      )

        i.fas.fa-bars


      // =======================================================
      // LOGO
      // =======================================================

      a.logo(
        href="/"
      )

        img(
          src=website.logo
          alt=website.name
        )

      // =======================================================
      // MENU
      // =======================================================

      nav.menu

        ul

          // ---------------------------------------------------
          // TRANG CHỦ
          // ---------------------------------------------------

          li

            a(
              href="/"
              class=(pageTitle === "Trang chủ" ? "active" : "")
            )
              | Trang Chủ


          // ---------------------------------------------------
          // TOUR TRONG NƯỚC
          // ---------------------------------------------------

          li.has-dropdown

            a(
              href="/tours"
            )

              span
                | Tour Trong Nước

              i.fas.fa-caret-down.arrow


            ul.dropdown

              li

                a(
                  href="/tours/mien-bac"
                )
                  | Tour Miền Bắc


              li

                a(
                  href="/tours/mien-trung"
                )
                  | Tour Miền Trung


              li

                a(
                  href="/tours/mien-nam"
                )
                  | Tour Miền Nam


              li

                a(
                  href="/tours/xuyen-viet"
                )
                  | Tour Xuyên Việt


          // ---------------------------------------------------
          // TOUR NƯỚC NGOÀI
          // ---------------------------------------------------

          li.has-dropdown

            a(
              href="/tours/foreign"
            )

              span
                | Tour Nước Ngoài

              i.fas.fa-caret-down.arrow


            ul.dropdown

              li

                a(
                  href="/tours/foreign/asia"
                )
                  | Tour Châu Á


              li

                a(
                  href="/tours/foreign/europe"
                )
                  | Tour Châu Âu


              li

                a(
                  href="/tours/foreign/america"
                )
                  | Tour Châu Mỹ


              li

                a(
                  href="/tours/foreign/australia"
                )
                  | Tour Châu Úc


          // ---------------------------------------------------
          // TIN TỨC
          // ---------------------------------------------------

          li

            a(
              href="/news"
            )
              | Tin Tức


          // ---------------------------------------------------
          // LIÊN HỆ
          // ---------------------------------------------------

          li

            a(
              href="/contact"
            )
              | Liên Hệ


      // =======================================================
      // HEADER ACTIONS
      // =======================================================

      .header-actions

        // -----------------------------------------------------
        // ĐĂNG NHẬP / ĐĂNG KÝ (hoặc thông tin người dùng nếu đã đăng nhập)
        // -----------------------------------------------------

        .auth-links

          if currentUser

            a.welcome-text(
              href=(currentUser.role === "admin" ? "/admin/dashboard" : "/info")
            )
              | Xin chào, #{currentUser.fullName}

            a.logout-link(
              href="/logout"
            )
              | Đăng xuất

          else

            a.login-link(
              href="/login"
            )
              | Đăng nhập


            span.divider
              | |


            a.register-link(
              href="/register"
            )
              | Đăng ký


        // -----------------------------------------------------
        // GIỎ HÀNG
        // -----------------------------------------------------

        a.cart(
          href="/cart"
          aria-label="Giỏ hàng"
        )

          i.fas.fa-shopping-cart


          span.cart-count#header-cart-count
            = cartCount || 0


  // =========================================================
  // MENU OVERLAY
  // =========================================================

  .menu-overlay