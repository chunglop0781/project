  // =========================================================
  // DANH SÁCH TOUR
  // KHÔNG PHÂN TRANG
  // =========================================================

  section.tour-page

    .tour-page-container


      // =======================================================
      // BỘ LỌC
      // =======================================================

      aside.tour-filter

        .tour-filter-title
          h2 Bộ Lọc
          i.fas.fa-filter


        //- ĐIỂM ĐI
        .tour-filter-group
          label(for="tour-from") Điểm đi

          .tour-select
            select#tour-from(name="from")
              option(value="") -- Chọn điểm đi --
              option(value="ha-noi") Hà Nội
              option(value="tp-hcm") TP. Hồ Chí Minh
              option(value="da-nang") Đà Nẵng


        //- ĐIỂM ĐẾN
        .tour-filter-group
          label(for="tour-to") Điểm đến

          .tour-select
            select#tour-to(name="to")
              option(value="") -- Chọn điểm đến --
              option(value="thai-lan") Thái Lan
              option(value="singapore") Singapore
              option(value="han-quoc") Hàn Quốc
              option(value="nhat-ban") Nhật Bản
              option(value="trung-quoc") Trung Quốc
              option(value="dai-loan") Đài Loan
              option(value="chau-au") Châu Âu
              option(value="dubai") Dubai
              option(value="uc") Úc
              option(value="my") Mỹ
              option(value="canada") Canada


        //- NGÀY KHỞI HÀNH
        .tour-filter-group
          label(for="tour-date") Ngày khởi hành

          .tour-input
            input#tour-date(
              type="date"
              name="date"
            )


        //- SỐ LƯỢNG HÀNH KHÁCH
        .tour-filter-group
          label Số lượng hành khách

          .tour-passenger
            input(
              type="number"
              min="1"
              value="1"
              placeholder="Người lớn"
              name="adult"
            )

          .tour-passenger
            input(
              type="number"
              min="0"
              value="0"
              placeholder="Trẻ em"
              name="child"
            )

          .tour-passenger
            input(
              type="number"
              min="0"
              value="0"
              placeholder="Em bé"
              name="baby"
            )


        //- MỨC GIÁ
        .tour-filter-group
          label(for="tour-price") Mức giá

          .tour-select
            select#tour-price(name="price")
              option(value="") -- Chọn mức giá --
              option(value="under-10") Dưới 10 triệu
              option(value="10-20") 10 - 20 triệu
              option(value="20-40") 20 - 40 triệu
              option(value="40-60") 40 - 60 triệu
              option(value="over-60") Trên 60 triệu


        button.tour-filter-button(type="button")
          i.fas.fa-search
          |  Áp dụng


      // =======================================================
      // KẾT QUẢ TOUR
      // =======================================================

      .tour-result

        .tour-result-header

          h2 Tour Nước Ngoài

          p
            | Du lịch Châu Á: là châu lục lớn và đông dân nhất thế giới. Châu Á cũng có nhiều danh lam thắng cảnh
            | đẹp tại một số quốc gia như Hàn Quốc, Nhật Bản, Trung Quốc, Việt Nam,... và VK Travel là nhà tổ chức
            | du lịch chuyên nghiệp hàng đầu Châu Á, đô 5 lần liên tiếp nhận giải TTG Travel Awards. Hãy cùng
            | 28. Travel du lịch Châu Á để tận hưởng những dịch vụ tốt nhất.


        //- SẮP XẾP
        .tour-sort

          .tour-sort-left
            span Sắp xếp:

            .tour-sort-dropdown

              button.tour-sort-toggle(type="button")
                span.tour-sort-toggle-text Phổ biến
                i.fas.fa-chevron-down

              ul.tour-sort-menu

                li.tour-sort-item.is-active(data-sort="popular")
                  span Phổ biến
                  i.fas.fa-check

                li.tour-sort-item(data-sort="price-asc")
                  span Giá tăng dần
                  i.fas.fa-check

                li.tour-sort-item(data-sort="price-desc")
                  span Giá giảm dần
                  i.fas.fa-check

                li.tour-sort-item(data-sort="hot-discount")
                  span Khuyến Mại Hot
                  i.fas.fa-check

          .tour-total
            | Có
            strong  20
            |  tour


        // =====================================================
        // CARD TOUR
        // =====================================================

        .tour-list

          each tour in productListSection6
            +product-item(tour)


  // =========================================================
  // STYLE: DROPDOWN SẮP XẾP
  // =========================================================

  style.
    .tour-sort-dropdown {
      position: relative;
      display: inline-block;
    }

    .tour-sort-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border: 1px solid #e0e0e0;
      border-radius: 6px;
      background: #fff;
      cursor: pointer;
      font-size: 14px;
      color: #333;
    }

    .tour-sort-toggle i {
      font-size: 11px;
      transition: transform 0.2s ease;
    }

    .tour-sort-dropdown.is-open .tour-sort-toggle i {
      transform: rotate(180deg);
    }

    .tour-sort-menu {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      min-width: 180px;
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 6px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      list-style: none;
      margin: 0;
      padding: 6px 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: all 0.15s ease;
      z-index: 20;
    }

    .tour-sort-dropdown.is-open .tour-sort-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .tour-sort-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 9px 14px;
      font-size: 14px;
      color: #333;
      cursor: pointer;
    }

    .tour-sort-item:hover {
      background: #f5f5f5;
    }

    .tour-sort-item i {
      font-size: 12px;
      color: #e6383f;
      opacity: 0;
      visibility: hidden;
    }

    .tour-sort-item.is-active {
      color: #e6383f;
      font-weight: 600;
    }

    .tour-sort-item.is-active i {
      opacity: 1;
      visibility: visible;
    }


  // =========================================================
  // SCRIPT: XỬ LÝ DROPDOWN SẮP XẾP
  // =========================================================

  script.
    document.addEventListener('DOMContentLoaded', function () {
      var dropdown = document.querySelector('.tour-sort-dropdown')
      if (!dropdown) return

      var toggle = dropdown.querySelector('.tour-sort-toggle')
      var toggleText = dropdown.querySelector('.tour-sort-toggle-text')
      var items = dropdown.querySelectorAll('.tour-sort-item')
      var tourList = document.querySelector('.tour-list')

      // Mở / đóng dropdown khi bấm nút
      toggle.addEventListener('click', function (e) {
        e.stopPropagation()
        dropdown.classList.toggle('is-open')
      })

      // Đóng dropdown khi bấm ra ngoài
      document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target)) {
          dropdown.classList.remove('is-open')
        }
      })

      // Chọn 1 lựa chọn sắp xếp
      items.forEach(function (item) {
        item.addEventListener('click', function () {
          items.forEach(function (i) { i.classList.remove('is-active') })
          item.classList.add('is-active')

          toggleText.textContent = item.querySelector('span').textContent
          dropdown.classList.remove('is-open')

          sortTours(item.dataset.sort)
        })
      })

      function sortTours (type) {
        if (!tourList) return
        var cards = Array.prototype.slice.call(tourList.querySelectorAll('.tour-card'))

        cards.sort(function (a, b) {
          if (type === 'price-asc') {
            return Number(a.dataset.price) - Number(b.dataset.price)
          }
          if (type === 'price-desc') {
            return Number(b.dataset.price) - Number(a.dataset.price)
          }
          if (type === 'hot-discount') {
            return Number(b.dataset.discount) - Number(a.dataset.discount)
          }
          return 0 // "popular" giữ nguyên thứ tự gốc
        })

        cards.forEach(function (card) {
          tourList.appendChild(card)
        })
      }
    })
