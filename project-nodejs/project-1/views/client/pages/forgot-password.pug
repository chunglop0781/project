doctype html
html(lang="vi")

  head

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    )

    title= (pageTitle ? pageTitle + " - " : "") + "Quên Mật Khẩu - Website Du Lịch"

    link(
      rel="icon"
      href="/assets/image/logo.png"
      type="image/png"
    )

    link(
      rel="preconnect"
      href="https://fonts.googleapis.com"
    )

    link(
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    )

    link(
      rel="stylesheet"
      href="/assets/css/style.css"
    )


  body

    include ../../partials/header.pug


    // =========================================================
    // QUÊN MẬT KHẨU
    // =========================================================

    main.auth-page

      .auth-wrapper

        .auth-card

          .auth-card-head

            h1.auth-title
              | Quên Mật Khẩu

            p.auth-subtitle
              | Vui lòng nhập email để tiếp tục


          // =====================================================
          // ERROR
          // =====================================================

          if typeof error !== "undefined" && error

            .auth-alert.auth-alert-error

              i.fas.fa-circle-exclamation

              span= error


          // =====================================================
          // SUCCESS
          // =====================================================

          if typeof success !== "undefined" && success

            .auth-alert.auth-alert-success

              i.fas.fa-circle-check

              span= success


          // =====================================================
          // FORM
          // =====================================================

          form#forgot-password-form.auth-form(
            action="/forgot-password"
            method="POST"
            novalidate
          )

            .auth-form-group

              label(
                for="email"
              )
                | Email

              .auth-input-icon

                i.fas.fa-envelope

                input#email(
                  type="email"
                  name="email"
                  placeholder="Ví dụ: levana@gmail.com"
                  autocomplete="email"
                  required
                )


            span#forgotPasswordFormError.auth-form-error


            button.auth-submit(
              type="submit"
            )

              i.fas.fa-paper-plane

              | Gửi Mã OTP


          p.auth-switch

            | Bạn đã nhớ mật khẩu?

            a(
              href="/login"
            )
              | Đăng nhập


    // =========================================================
    // JAVASCRIPT
    // =========================================================

    script(
      src="/assets/js/account.js"
    )