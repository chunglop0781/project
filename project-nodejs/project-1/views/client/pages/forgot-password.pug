doctype html
html(lang="vi")

  head

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title= (pageTitle ? pageTitle + " - " : "") + "Quên Mật Khẩu - Website Du Lịch"

    link(rel="icon" href="/assets/image/logo.png" type="image/png")

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    link(rel="stylesheet" href="/assets/css/style.css")


  body

    include ../../partials/header.pug


    // =========================================================
    // TRANG QUÊN MẬT KHẨU
    // =========================================================

    main.auth-page

      .auth-wrapper

        .auth-card

          .auth-card-head

            h1.auth-title Quên Mật Khẩu

            p.auth-subtitle Vui lòng nhập email để tiếp tục


          // -------------------------------------------------------
          // THÔNG BÁO LỖI (từ server)
          // -------------------------------------------------------

          if typeof error !== "undefined" && error

            .auth-alert.auth-alert-error

              i.fas.fa-circle-exclamation

              span= error


          // -------------------------------------------------------
          // THÔNG BÁO THÀNH CÔNG (từ server, sau khi gửi OTP)
          // -------------------------------------------------------

          if typeof success !== "undefined" && success

            .auth-alert.auth-alert-success

              i.fas.fa-circle-check

              span= success


          // -------------------------------------------------------
          // FORM QUÊN MẬT KHẨU
          //
          // TODO (backend / MongoDB):
          //   - action="/forgot-password" method="POST" gửi lên server
          //   - Server nhận req.body.email
          //   - Tìm user trong MongoDB theo email (vd: User.findOne({ email }))
          //   - Nếu tồn tại: tạo mã OTP, lưu kèm thời gian hết hạn, gửi email OTP
          //   - Nếu không tồn tại: render lại kèm biến `error`
          //   - Sau khi gửi thành công: redirect sang /verify-otp (hoặc render kèm `success`)
          // -------------------------------------------------------

          form#forgotPasswordForm.auth-form(action="/forgot-password" method="POST" novalidate)

            .auth-form-group

              label(for="forgot-email") Email

              .auth-input-icon

                i.fas.fa-envelope

                input#forgot-email(
                  type="email"
                  name="email"
                  placeholder="Ví dụ: levana@gmail.com"
                  autocomplete="email"
                  required
                )


            span#forgotPasswordFormError.auth-form-error


            button.auth-submit(type="submit")

              i.fas.fa-paper-plane

              | Gửi Mã OTP


          p.auth-switch
            | Bạn đã nhớ mật khẩu?
            a(href="/login") Đăng nhập


    // =========================================================
    // JS
    // =========================================================

    script(src="/assets/js/script.js")
