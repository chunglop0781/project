doctype html
html(lang="vi")

  head

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title= (pageTitle ? pageTitle + " - " : "") + "Xác Minh OTP - Website Du Lịch"

    link(rel="icon" href="/assets/image/logo.png" type="image/png")

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    link(rel="stylesheet" href="/assets/css/style.css")


  body

    include ../../partials/header.pug


    // =========================================================
    // TRANG XÁC MINH MÃ OTP
    // =========================================================

    main.auth-page

      .auth-wrapper

        .auth-card

          .auth-card-head

            h1.auth-title Xác Minh OTP

            p.auth-subtitle
              | Nhập mã OTP đã gửi tới email
              if typeof email !== "undefined" && email
                strong= " " + email


          // -------------------------------------------------------
          // THÔNG BÁO LỖI (từ server)
          // -------------------------------------------------------

          if typeof error !== "undefined" && error

            .auth-alert.auth-alert-error

              i.fas.fa-circle-exclamation

              span= error


          // -------------------------------------------------------
          // FORM XÁC MINH OTP
          //
          // TODO (backend / MongoDB):
          //   - Trang này chỉ nên truy cập được sau khi user đã submit
          //     /forgot-password thành công (lưu req.session.resetEmail
          //     và req.session.otpExpires khi gửi OTP)
          //   - action="/verify-otp" method="POST" gửi lên server
          //   - Server nhận req.body.otp
          //   - So sánh với mã OTP đã lưu (vd: trong user hoặc collection riêng),
          //     kiểm tra chưa hết hạn (otpExpires > Date.now())
          //   - Nếu đúng: đánh dấu req.session.otpVerified = true,
          //     redirect sang /otp-password
          //   - Nếu sai/hết hạn: render lại kèm biến `error`
          //   - Có thể thêm route resend OTP riêng nếu cần
          // -------------------------------------------------------

          form#verifyOtpForm.auth-form(action="/verify-otp" method="POST" novalidate)

            .auth-form-group

              label(for="verify-otp-code") Mã OTP

              .auth-input-icon

                i.fas.fa-shield-halved

                input#verify-otp-code(
                  type="text"
                  name="otp"
                  placeholder="Nhập mã 6 chữ số"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  maxlength="6"
                  autocomplete="one-time-code"
                  required
                )


            span#verifyOtpFormError.auth-form-error


            button.auth-submit(type="submit")

              i.fas.fa-circle-check

              | Xác Nhận


          p.auth-switch
            | Chưa nhận được mã?
            a(href="/forgot-password") Gửi lại

          p.auth-switch
            | Bạn đã nhớ mật khẩu?
            a(href="/login") Đăng nhập


    // =========================================================
    // JS
    // =========================================================

    script(src="/assets/js/script.js")
