doctype html
html(lang="vi")

  head

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title= (pageTitle ? pageTitle + " - " : "") + "Đổi Mật Khẩu - Website Du Lịch"

    link(rel="icon" href="/assets/image/logo.png" type="image/png")

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    link(rel="stylesheet" href="/assets/css/style.css")


  body

    include ../../partials/header.pug


    // =========================================================
    // TRANG ĐỔI MẬT KHẨU (SAU KHI XÁC MINH OTP)
    // =========================================================

    main.auth-page

      .auth-wrapper

        .auth-card

          .auth-card-head

            h1.auth-title Đổi Mật Khẩu

            p.auth-subtitle Vui lòng nhập mật khẩu để tiếp tục


          // -------------------------------------------------------
          // THÔNG BÁO LỖI (từ server)
          // -------------------------------------------------------

          if typeof error !== "undefined" && error

            .auth-alert.auth-alert-error

              i.fas.fa-circle-exclamation

              span= error


          // -------------------------------------------------------
          // FORM ĐỔI MẬT KHẨU
          //
          // TODO (backend / MongoDB):
          //   - Trang này chỉ nên truy cập được sau khi user đã xác minh
          //     OTP thành công (lưu trạng thái đã xác minh vào session,
          //     vd: req.session.resetEmail = email, kèm thời gian hết hạn)
          //   - action="/otp-password" method="POST" gửi lên server
          //   - Server nhận req.body.password, req.body.confirmPassword
          //   - Kiểm tra 2 mật khẩu khớp nhau, đủ độ dài tối thiểu
          //   - Hash password mới (bcrypt.hash) và cập nhật vào user
          //     (vd: User.findOneAndUpdate({ email: req.session.resetEmail }, { password: hashed }))
          //   - Xoá session tạm dùng cho quá trình quên mật khẩu
          //   - Redirect về /login kèm thông báo thành công
          //   - Nếu lỗi: render lại kèm biến `error`
          // -------------------------------------------------------

          form#otpPasswordForm.auth-form(action="/otp-password" method="POST" novalidate)

            .auth-form-group

              label(for="otp-password-new") Mật khẩu mới

              .auth-input-icon

                i.fas.fa-lock

                input#otp-password-new(
                  type="password"
                  name="password"
                  placeholder="Nhập mật khẩu mới"
                  autocomplete="new-password"
                  minlength="6"
                  required
                )

                button.auth-password-toggle(type="button" aria-label="Hiện mật khẩu")
                  i.fas.fa-eye


            .auth-form-group

              label(for="otp-password-confirm") Xác nhận mật khẩu

              .auth-input-icon

                i.fas.fa-lock

                input#otp-password-confirm(
                  type="password"
                  name="confirmPassword"
                  placeholder="Nhập lại mật khẩu mới"
                  autocomplete="new-password"
                  minlength="6"
                  required
                )

                button.auth-password-toggle(type="button" aria-label="Hiện mật khẩu")
                  i.fas.fa-eye


            span#otpPasswordFormError.auth-form-error


            button.auth-submit(type="submit")

              i.fas.fa-key

              | Thay Đổi


          p.auth-switch
            | Bạn đã nhớ mật khẩu?
            a(href="/login") Đăng nhập


    // =========================================================
    // JS
    // =========================================================

    script(src="/assets/js/script.js")
