doctype html
html(lang="vi")

    head

        meta(charset="UTF-8")

        meta(
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        )

        title= (pageTitle ? pageTitle + " - " : "") + "Đăng Nhập - Website Du Lịch"

        link(
            rel="icon"
            href="/assets/image/logo.png"
            type="image/png"
        )

        link(
            rel="preconnect"
            href="https://fonts.googleapis.com"
        )

        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        )

        link(
            rel="stylesheet"
            href="/assets/css/style.css"
        )


    body

        include ../../partials/header.pug


        main.auth-page

            .auth-wrapper

                .auth-card

                    .auth-card-head

                        h1.auth-title Đăng Nhập

                        p.auth-subtitle
                            | Đăng nhập để tiếp tục


                    // =====================================================
                    // VALIDATION ERROR
                    // =====================================================

                    if validationErrors && validationErrors.length

                        .auth-alert.auth-alert-error

                            i.fas.fa-circle-exclamation

                            .auth-validation-list

                                each message in validationErrors

                                    div= message


                    // =====================================================
                    // ERROR THÔNG THƯỜNG
                    // =====================================================

                    if typeof error !== "undefined" && error

                        .auth-alert.auth-alert-error

                            i.fas.fa-circle-exclamation

                            span= error


                    // =====================================================
                    // FORM
                    // =====================================================

                    form#loginForm.auth-form(
                        action="/login"
                        method="POST"
                        novalidate
                    )


                        // =================================================
                        // EMAIL
                        // =================================================

                        .auth-form-group

                            label(
                                for="login-email"
                            ) Email

                            .auth-input-icon

                                i.fas.fa-envelope

                                input#login-email(
                                    type="email"
                                    name="email"
                                    placeholder="Nhập email"
                                    autocomplete="email"
                                    value=formData && formData.email ? formData.email : ""
                                )


                        // =================================================
                        // MẬT KHẨU
                        // =================================================

                        .auth-form-group

                            label(
                                for="login-password"
                            ) Mật khẩu

                            .auth-input-icon

                                i.fas.fa-lock

                                input#login-password(
                                    type="password"
                                    name="password"
                                    placeholder="Nhập mật khẩu"
                                    autocomplete="current-password"
                                )

                                button.auth-password-toggle(
                                    type="button"
                                    aria-label="Hiện mật khẩu"
                                )

                                    i.fas.fa-eye


                        // =================================================
                        // GHI NHỚ MẬT KHẨU / QUÊN MẬT KHẨU
                        // =================================================

                        .auth-form-row

                            label.auth-checkbox

                                input(
                                    type="checkbox"
                                    name="rememberPassword"
                                    value="true"
                                    checked=formData && formData.rememberPassword
                                )

                                span.auth-checkbox-box

                                | Ghi nhớ mật khẩu

                            a(href="/forgot-password") Quên mật khẩu?


                        // =================================================
                        // ERROR FORM
                        // =================================================

                        span#loginFormError.auth-form-error


                        // =================================================
                        // SUBMIT
                        // =================================================

                        button.auth-submit(
                            type="submit"
                        )

                            i.fas.fa-right-to-bracket

                            | Đăng Nhập


                    // =====================================================
                    // REGISTER
                    // =====================================================

                    p.auth-switch

                        | Chưa có tài khoản?

                        a(href="/register") Đăng ký ngay


        script(
            src="/assets/js/script.js"
        )

        script(
            src="/assets/js/account.js"
        )