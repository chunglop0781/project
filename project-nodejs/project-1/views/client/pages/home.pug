extends ../../layouts/default
include ../mixins/product-item

block main

  // =========================================================
  // SECTION 1 - BANNER
  // =========================================================

  section.section-1

    //- ẢNH NỀN
    .section-1-background
      img(
        src="/assets/image/banner1.jpg"
        alt="Du lịch"
      )

    //- NỘI DUNG NẰM TRÊN ẢNH
    .section-1-content

      //- TIÊU ĐỀ
      .section-1-title
        h1
          | Du lịch Châu Á - Khám phá Mỹ, Úc, Âu
          br
          | Đi nơi đâu bạn muốn

      //- MÔ TẢ
      .section-1-description
        p
          | Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut
          br
          | labore et dolore magna aliqua.

      //- KHUNG TÌM KIẾM
      .section-1-search

        //- ĐIỂM ĐẾN
        .search-location
          i.fas.fa-map-marker-alt

          select(name="tour")
            option(value="" selected disabled) Bạn muốn đi đâu?
            option(value="mien-bac") Tour Miền Bắc
            option(value="mien-trung") Tour Miền Trung
            option(value="mien-nam") Tour Miền Nam
            option(value="xuyen-viet") Tour Xuyên Việt
            option(value="chau-a") Tour Châu Á
            option(value="chau-au") Tour Châu Âu
            option(value="chau-my") Tour Châu Mỹ
            option(value="chau-uc") Tour Châu Úc

          i.fas.fa-chevron-down

        //- HÀNG BÊN DƯỚI
        .search-row

          //- SỐ LƯỢNG
          .search-item
            i.fas.fa-user

            input(
              type="number"
              name="number"
              min="1"
              placeholder="Số lượng"
            )

          //- LỊCH KHỞI HÀNH
          .search-item
            i.fas.fa-calendar-alt

            input(
              type="text"
              name="date"
              placeholder="Lịch khởi hành"
              onfocus="this.type='date'"
              onblur="if(!this.value)this.type='text'"
            )

          //- NÚT TÌM KIẾM
          button.search-button(
            type="button"
          )
            i.fas.fa-search
            | Tìm kiếm


  // =========================================================
  // SECTION 2 - TOUR GIỜ CHÓT
  // =========================================================

  -
    var productListSection2 = [
      {
        avatar: "/assets/image/sec2-1.jpg",
        slug: "#",
        discount: 30,
        name: "Hà Nội - Lào Cai - SaPa 4N3Đ",
        priceOld: 13650000,
        priceNew: 2590000,
        code: "TOUR000001",
        departureDate: "22/12/2025",
        time: "10 Ngày 9 Đêm",
        ratingStars: 4,
        ratingTotal: 20,
        stock: 10
      },
      {
        avatar: "/assets/image/sec2-2.jpg",
        slug: "#",
        discount: 0,
        name: "Tour 2024 Phú Quốc - Thiên Đường Đảo Ngọc (3N2Đ)",
        priceOld: 12000000,
        priceNew: 12000000,
        code: "TOUR000002",
        departureDate: "24/12/2025",
        time: "3 Ngày 2 Đêm",
        ratingStars: 5,
        ratingTotal: 20,
        stock: 10
      },
      {
        avatar: "/assets/image/sec2-3.jpg",
        slug: "#",
        discount: 30,
        name: "Combo Đà Nẵng 2024: Đà Nẵng - Hội An - Bà Nà Hill",
        priceOld: 13650000,
        priceNew: 2590000,
        code: "TOUR000003",
        departureDate: "27/12/2025",
        time: "4 Ngày 3 Đêm",
        ratingStars: 3.5,
        ratingTotal: 20,
        stock: 10
      }
    ]

  section.section-2

    .section-2-container

      //- CỘT ƯU ĐÃI
      .section-2-sale

        h2
          | ƯU ĐÃI 2024
          br
          | TOUR GIỜ CHÓT

        p
          | Lorem ipsum dolor sit amet, consectetur
          br
          | adipiscing elit, sed do eiusmod tempor

        h3 Kết thúc sau

        .clock-expire(
          clock-expire="2026-12-10T15:00:00"
        )

          .section-2-countdown

            .countdown-item
              span.countdown-days 00

            .countdown-item
              span.countdown-hours 00

            .countdown-item
              span.countdown-minutes 00

            .countdown-item
              span.countdown-seconds 00

        .section-2-discount-title
          | GIẢM ĐẾN

        .section-2-discount-price
          | 990.000₫


      //- DANH SÁCH TOUR
      .section-2-tours

        button.section-2-arrow.section-2-arrow-prev(type="button")
          i.fas.fa-chevron-left

        .section-2-swiper.swiper

          .swiper-wrapper

            each item in productListSection2
              .swiper-slide
                +productItem(item)

        button.section-2-arrow.section-2-arrow-next(type="button")
          i.fas.fa-chevron-right

  //END SECTION 2 - TOUR GIỜ CHÓT


  // =========================================================
  // SECTION 3 - KHUYẾN MÃI
  // =========================================================

  section.section-3

    .section-3-container

      .section-3-title
        h2 Khuyến Mãi Bùng Nổ - Đánh Tan Nóng Bức

      .section-3-swiper.swiper

        .swiper-wrapper

          - for (var i = 1; i <= 10; i++)

            .swiper-slide

              a(href="#")

                img(
                  src=`/assets/image/sec3-${i}.jpg`
                  alt=`Khuyến mãi ${i}`
                )

        .swiper-pagination
  //END SECTION 3 - KHUYẾN MÃI