doctype html
html(lang="vi")

    head

        meta(charset="UTF-8")

        meta(
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        )

        title= (pageTitle ? pageTitle + " - " : "") + "Đăng Ký - Website Du Lịch"

        link(
            rel="icon"
            href="/assets/image/logo.png"
            type="image/png"
        )

        link(
            rel="preconnect"
            href="https://fonts.googleapis.com"
        )

        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        )

        link(
            rel="stylesheet"
            href="/assets/css/style.css"
        )


    body

        include ../../partials/header.pug


        main.auth-page

            .auth-wrapper

                .auth-card

                    .auth-card-head

                        h1.auth-title Đăng Ký

                        p.auth-subtitle
                            | Tạo tài khoản mới


                    // =====================================================
                    // VALIDATION ERROR
                    // =====================================================

                    if validationErrors && validationErrors.length

                        .auth-alert.auth-alert-error

                            i.fas.fa-circle-exclamation

                            .auth-validation-list

                                each message in validationErrors

                                    div= message


                    // =====================================================
                    // ERROR THÔNG THƯỜNG
                    // =====================================================

                    if typeof error !== "undefined" && error

                        .auth-alert.auth-alert-error

                            i.fas.fa-circle-exclamation

                            span= error


                    // =====================================================
                    // FORM
                    // =====================================================

                    form#registerForm.auth-form(
                        action="/register"
                        method="POST"
                        novalidate
                    )


                        // =================================================
                        // HỌ VÀ TÊN
                        // =================================================

                        .auth-form-group

                            label(
                                for="register-fullName"
                            ) Họ và tên

                            .auth-input-icon

                                i.fas.fa-user

                                input#register-fullName(
                                    type="text"
                                    name="fullName"
                                    placeholder="Nhập họ và tên"
                                    autocomplete="name"
                                    value=formData && formData.fullName ? formData.fullName : ""
                                )


                        // =================================================
                        // EMAIL
                        // =================================================

                        .auth-form-group

                            label(
                                for="register-email"
                            ) Email

                            .auth-input-icon

                                i.fas.fa-envelope

                                input#register-email(
                                    type="email"
                                    name="email"
                                    placeholder="Nhập email"
                                    autocomplete="email"
                                    value=formData && formData.email ? formData.email : ""
                                )


                        // =================================================
                        // SỐ ĐIỆN THOẠI
                        // =================================================

                        .auth-form-group

                            label(
                                for="register-phone"
                            ) Số điện thoại

                            .auth-input-icon

                                i.fas.fa-phone

                                input#register-phone(
                                    type="tel"
                                    name="phone"
                                    placeholder="Nhập số điện thoại"
                                    autocomplete="tel"
                                    value=formData && formData.phone ? formData.phone : ""
                                )


                        // =================================================
                        // MẬT KHẨU
                        // =================================================

                        .auth-form-group

                            label(
                                for="register-password"
                            ) Mật khẩu

                            .auth-input-icon

                                i.fas.fa-lock

                                input#register-password(
                                    type="password"
                                    name="password"
                                    placeholder="Nhập mật khẩu"
                                    autocomplete="new-password"
                                )

                                button.auth-password-toggle(
                                    type="button"
                                    aria-label="Hiện mật khẩu"
                                )

                                    i.fas.fa-eye


                        // =================================================
                        // XÁC NHẬN MẬT KHẨU
                        // =================================================

                        .auth-form-group

                            label(
                                for="register-confirmPassword"
                            ) Xác nhận mật khẩu

                            .auth-input-icon

                                i.fas.fa-lock

                                input#register-confirmPassword(
                                    type="password"
                                    name="confirmPassword"
                                    placeholder="Nhập lại mật khẩu"
                                    autocomplete="new-password"
                                )

                                button.auth-password-toggle(
                                    type="button"
                                    aria-label="Hiện mật khẩu"
                                )

                                    i.fas.fa-eye


                        // =================================================
                        // ĐIỀU KHOẢN
                        // =================================================

                        label.auth-checkbox

                            input(
                                type="checkbox"
                                name="agreeTerms"
                                value="on"
                                checked=formData && formData.agreeTerms === "on"
                            )

                            span.auth-checkbox-box

                            | Tôi đồng ý với

                            a(
                                href="/terms"
                            ) điều khoản sử dụng


                        // =================================================
                        // ERROR FORM
                        // =================================================

                        span#registerFormError.auth-form-error


                        // =================================================
                        // SUBMIT
                        // =================================================

                        button.auth-submit(
                            type="submit"
                        )

                            i.fas.fa-user-plus

                            | Đăng Ký


                    // =====================================================
                    // LOGIN
                    // =====================================================

                    p.auth-switch

                        | Đã có tài khoản?

                        a(href="/login") Đăng nhập


        script(
            src="/assets/js/script.js"
        )

        script(
            src="/assets/js/account.js"
        )