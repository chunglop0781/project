doctype html
html(lang="vi")

    head

        meta(charset="UTF-8")

        meta(
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        )

        title= (pageTitle ? pageTitle + " - " : "") + "Đổi Mật Khẩu - Website Du Lịch"

        link(
            rel="icon"
            href="/assets/image/logo.png"
            type="image/png"
        )

        link(
            rel="preconnect"
            href="https://fonts.googleapis.com"
        )

        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        )

        link(
            rel="stylesheet"
            href="/assets/css/style.css"
        )


    body

        include ../../partials/header.pug


        // =========================================================
        // TRANG ĐỔI MẬT KHẨU
        // =========================================================

        main.auth-page

            .auth-wrapper

                .auth-card

                    .auth-card-head

                        h1.auth-title Đổi Mật Khẩu

                        p.auth-subtitle

                            | Đổi mật khẩu cho email

                            if typeof email !== "undefined" && email

                                strong= " " + email


                    // =====================================================
                    // VALIDATION ERROR
                    // =====================================================

                    if validationErrors && validationErrors.length

                        .auth-alert.auth-alert-error

                            i.fas.fa-circle-exclamation

                            .auth-validation-list

                                each message in validationErrors

                                    div= message


                    // =====================================================
                    // ERROR THÔNG THƯỜNG
                    // =====================================================

                    if typeof error !== "undefined" && error

                        .auth-alert.auth-alert-error

                            i.fas.fa-circle-exclamation

                            span= error


                    // =====================================================
                    // SUCCESS
                    // =====================================================

                    if typeof success !== "undefined" && success

                        .auth-alert.auth-alert-success

                            i.fas.fa-circle-check

                            span= success


                    // =====================================================
                    // FORM
                    // =====================================================

                    form#changePasswordForm.auth-form(
                        action="/change-password"
                        method="POST"
                        novalidate
                    )


                        // =================================================
                        // RESET BẰNG OTP
                        // =================================================

                        input(
                            type="hidden"
                            name="resetByOtp"
                            value="true"
                        )


                        // =================================================
                        // MẬT KHẨU HIỆN TẠI
                        // =================================================

                        .auth-form-group

                            label(
                                for="change-password-current"
                            ) Mật khẩu hiện tại

                            .auth-input-icon

                                i.fas.fa-lock

                                input#change-password-current(
                                    type="password"
                                    name="currentPassword"
                                    placeholder="Nhập mật khẩu hiện tại"
                                    autocomplete="current-password"
                                )

                                button.auth-password-toggle(
                                    type="button"
                                    aria-label="Hiện mật khẩu"
                                )

                                    i.fas.fa-eye


                        // =================================================
                        // MẬT KHẨU MỚI
                        // =================================================

                        .auth-form-group

                            label(
                                for="change-password-new"
                            ) Mật khẩu mới

                            .auth-input-icon

                                i.fas.fa-lock

                                input#change-password-new(
                                    type="password"
                                    name="newPassword"
                                    placeholder="Nhập mật khẩu mới"
                                    autocomplete="new-password"
                                    minlength="6"
                                )

                                button.auth-password-toggle(
                                    type="button"
                                    aria-label="Hiện mật khẩu"
                                )

                                    i.fas.fa-eye


                        // =================================================
                        // XÁC NHẬN MẬT KHẨU
                        // =================================================

                        .auth-form-group

                            label(
                                for="change-password-confirm"
                            ) Xác nhận mật khẩu mới

                            .auth-input-icon

                                i.fas.fa-lock

                                input#change-password-confirm(
                                    type="password"
                                    name="confirmPassword"
                                    placeholder="Nhập lại mật khẩu mới"
                                    autocomplete="new-password"
                                    minlength="6"
                                )

                                button.auth-password-toggle(
                                    type="button"
                                    aria-label="Hiện mật khẩu"
                                )

                                    i.fas.fa-eye


                        // =================================================
                        // LỖI FORM
                        // =================================================

                        span#changePasswordFormError.auth-form-error


                        // =================================================
                        // SUBMIT
                        // =================================================

                        button.auth-submit(
                            type="submit"
                        )

                            i.fas.fa-key

                            | Đổi Mật Khẩu


                    // =====================================================
                    // QUAY LẠI
                    // =====================================================

                    p.auth-switch

                        a(href="/") Quay lại trang chủ


        script(
            src="/assets/js/script.js"
        )

        script(
            src="/assets/js/account.js"
        )