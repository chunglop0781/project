doctype html
html(lang="vi")

  head

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title= (pageTitle ? pageTitle + " - " : "") + "Đổi Mật Khẩu - Website Du Lịch"

    link(rel="icon" href="/assets/image/logo.png" type="image/png")

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    link(rel="stylesheet" href="/assets/css/style.css")


  body

    include ../../partials/header.pug


    // =========================================================
    // TRANG ĐỔI MẬT KHẨU (KHI ĐÃ ĐĂNG NHẬP)
    // Khác với otp-password.pug: trang này yêu cầu nhập mật khẩu
    // HIỆN TẠI để xác thực, không cần đi qua OTP.
    // =========================================================

    main.auth-page

      .auth-wrapper

        .auth-card

          .auth-card-head

            h1.auth-title Đổi Mật Khẩu

            p.auth-subtitle
              | Đổi mật khẩu cho email
              if typeof email !== "undefined" && email
                strong= " " + email


          // -------------------------------------------------------
          // THÔNG BÁO LỖI (từ server)
          // -------------------------------------------------------

          if typeof error !== "undefined" && error

            .auth-alert.auth-alert-error

              i.fas.fa-circle-exclamation

              span= error


          // -------------------------------------------------------
          // THÔNG BÁO THÀNH CÔNG (từ server)
          // -------------------------------------------------------

          if typeof success !== "undefined" && success

            .auth-alert.auth-alert-success

              i.fas.fa-circle-check

              span= success


          // -------------------------------------------------------
          // FORM ĐỔI MẬT KHẨU
          //
          // TODO (backend / MongoDB):
          //   - Route này PHẢI đi qua middleware requireLogin
          //     (chỉ user đã đăng nhập mới vào được)
          //   - action="/change-password" method="POST" gửi lên server
          //   - Server nhận req.body.currentPassword, req.body.newPassword,
          //     req.body.confirmPassword
          //   - Lấy user hiện tại theo req.session.user.id
          //   - So sánh currentPassword với mật khẩu đã hash trong DB
          //     (bcrypt.compare) -> sai thì báo lỗi "Mật khẩu hiện tại không đúng"
          //   - Kiểm tra newPassword === confirmPassword, đủ độ dài tối thiểu
          //   - Hash newPassword (bcrypt.hash) và cập nhật vào user
          //   - Render lại kèm biến `success`, hoặc redirect kèm flash message
          // -------------------------------------------------------

          form#changePasswordForm.auth-form(action="/change-password" method="POST" novalidate)

            .auth-form-group

              label(for="change-password-current") Mật khẩu hiện tại

              .auth-input-icon

                i.fas.fa-lock

                input#change-password-current(
                  type="password"
                  name="currentPassword"
                  placeholder="Nhập mật khẩu hiện tại"
                  autocomplete="current-password"
                  required
                )

                button.auth-password-toggle(type="button" aria-label="Hiện mật khẩu")
                  i.fas.fa-eye


            .auth-form-group

              label(for="change-password-new") Mật khẩu mới

              .auth-input-icon

                i.fas.fa-lock

                input#change-password-new(
                  type="password"
                  name="newPassword"
                  placeholder="Nhập mật khẩu mới"
                  autocomplete="new-password"
                  minlength="6"
                  required
                )

                button.auth-password-toggle(type="button" aria-label="Hiện mật khẩu")
                  i.fas.fa-eye


            .auth-form-group

              label(for="change-password-confirm") Xác nhận mật khẩu mới

              .auth-input-icon

                i.fas.fa-lock

                input#change-password-confirm(
                  type="password"
                  name="confirmPassword"
                  placeholder="Nhập lại mật khẩu mới"
                  autocomplete="new-password"
                  minlength="6"
                  required
                )

                button.auth-password-toggle(type="button" aria-label="Hiện mật khẩu")
                  i.fas.fa-eye


            span#changePasswordFormError.auth-form-error


            button.auth-submit(type="submit")

              i.fas.fa-key

              | Đổi Mật Khẩu


          p.auth-switch
            a(href="/") Quay lại trang chủ


    // =========================================================
    // JS
    // =========================================================

    script(src="/assets/js/script.js")
