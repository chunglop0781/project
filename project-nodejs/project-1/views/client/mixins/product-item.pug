//- =========================================================
//- MIXIN: PRODUCT ITEM (CARD TOUR)
//- Hỗ trợ:
//-   +productItem(item)
//-   +product-item(tour)
//-
//- @param tour - object chứa dữ liệu 1 tour, dạng:
//-   {
//-     avatar, slug, discount, name,
//-     priceOld, priceNew, code,
//-     departureDate, time,
//-     ratingStars, ratingTotal, stock
//-   }
//- =========================================================


//- =========================================================
//- MIXIN: PRODUCT ITEM - CAMEL CASE
//- =========================================================

mixin productItem(tour)

  article.tour-card(
    data-price=tour.priceNew
    data-discount=tour.discount
  )

    //- =====================================================
    //- ẢNH TOUR
    //- =====================================================

    .tour-card-image

      a(href=tour.slug)

        img(
          src=tour.avatar
          alt=tour.name
          loading="lazy"
        )

      //- GIẢM GIÁ
      if tour.discount > 0

        .tour-discount
          i.fas.fa-bolt
          |  Giảm #{tour.discount}%


    //- =====================================================
    //- NỘI DUNG
    //- =====================================================

    .tour-card-content

      //- ===================================================
      //- TÊN TOUR
      //- ===================================================

      h3.tour-card-name

        a(
          href=tour.slug
          style="text-decoration: none; color: inherit;"
        )
          = tour.name


      //- ===================================================
      //- GIÁ
      //- ===================================================

      .tour-price

        if tour.priceOld > tour.priceNew

          span.tour-price-old
            = tour.priceOld.toLocaleString('vi-VN')
            | ₫

        span.tour-price-new
          = tour.priceNew.toLocaleString('vi-VN')
          | ₫


      //- ===================================================
      //- MÃ TOUR
      //- ===================================================

      .tour-info

        i.fas.fa-ticket-alt

        span Mã tour:

        strong= tour.code


      //- ===================================================
      //- NGÀY KHỞI HÀNH
      //- ===================================================

      .tour-info

        i.fas.fa-calendar-alt

        span Khởi hành:

        strong= tour.departureDate


      //- ===================================================
      //- THỜI GIAN
      //- ===================================================

      .tour-info

        i.fas.fa-clock

        span Thời gian:

        strong= tour.time


      //- ===================================================
      //- RATING
      //- ===================================================

      .tour-rating

        .tour-stars

          - var fullStars = Math.floor(tour.ratingStars)

          - for (var star = 1; star <= 5; star++)

            if star <= fullStars

              i.fas.fa-star

            else

              i.far.fa-star

        span
          | #{tour.ratingStars}/5
          |  (#{tour.ratingTotal} đánh giá)


      //- ===================================================
      //- SỐ CHỖ
      //- ===================================================

      if tour.stock <= 5

        .tour-stock

          i.fas.fa-fire

          |  Chỉ còn #{tour.stock} chỗ

      else

        .tour-stock

          i.fas.fa-check-circle

          |  Còn #{tour.stock} chỗ



//- =========================================================
//- MIXIN: PRODUCT ITEM - KEBAB CASE
//- Dùng cho:
//-   +product-item(tour)
//- =========================================================

mixin product-item(tour)

  +productItem(tour)