doctype html
html(lang="vi")

  head

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title= (pageTitle ? pageTitle + " - " : "") + "Quản Trị 28 Travel"

    link(rel="icon" href="/assets/image/icon.png" type="image/png")

    //- =====================================================
    //- FONT + ICON
    //- =====================================================

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    //- =====================================================
    //- CSS
    //- =====================================================

    link(rel="stylesheet" href="/admin/assets/css/admin.css")

    block styles

  body.admin-body

    .admin-wrapper

      //- ===================================================
      //- SIDEBAR
      //- ===================================================

      include ../partials/sidebar.pug

      //- ===================================================
      //- MAIN
      //- ===================================================

      .admin-main

        include ../partials/topbar.pug

        main.admin-content

          //- =================================================
          //- FLASH MESSAGE (đã thêm điều kiện length)
          //- =================================================

          if typeof success !== "undefined" && success && success.length
            .admin-alert.admin-alert-success
              i.fas.fa-circle-check
              span= success
              button.admin-alert-close(type="button" aria-label="Đóng")
                i.fas.fa-xmark

          if typeof error !== "undefined" && error && error.length
            .admin-alert.admin-alert-error
              i.fas.fa-circle-exclamation
              span= error
              button.admin-alert-close(type="button" aria-label="Đóng")
                i.fas.fa-xmark

          block content

    .admin-overlay#adminOverlay

    //- =====================================================
    //- JS
    //- =====================================================

    script(src="/admin/assets/js/admin.js")

    block scripts