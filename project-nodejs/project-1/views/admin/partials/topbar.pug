header.admin-topbar

  //- =========================================================
  //- BÊN TRÁI
  //- =========================================================

  .admin-topbar-left

    button.admin-sidebar-toggle#adminSidebarToggle(type="button" aria-label="Menu")
      i.fas.fa-bars

    h1.admin-topbar-title= pageTitle || "Tổng Quan"


  //- =========================================================
  //- BÊN PHẠI
  //- =========================================================

  .admin-topbar-right

    button.admin-topbar-icon(type="button" aria-label="Thông báo")
      i.fas.fa-bell
      if typeof notificationCount !== "undefined" && notificationCount > 0
        span.admin-topbar-dot

    .admin-user-menu

      button.admin-user-trigger#adminUserTrigger(type="button")

        //- =====================================================
        //- LẤY ẢNH ĐẠI DIỆN - CHECK TỪ SESSION USER
        //- =====================================================
        - var avatarSrc = '/admin/image/avatar-default.png'
        - if (typeof adminUser !== 'undefined' && adminUser && adminUser.avatar) {
        -   avatarSrc = adminUser.avatar
        - } else if (typeof currentUser !== 'undefined' && currentUser && currentUser.avatar) {
        -   avatarSrc = currentUser.avatar
        - }
        - if (avatarSrc === '/admin/image/avatar-default.png' || avatarSrc === '' || avatarSrc === null) {
        -   avatarSrc = '/admin/image/avatar-default.png'
        - }
        
        img#adminAvatar.admin-user-avatar(
          src=avatarSrc
          alt=(adminUser && adminUser.fullName) ? adminUser.fullName : "Admin"
        )

        //- =====================================================
        //- THÔNG TIN USER
        //- =====================================================
        .admin-user-info
          span.admin-user-name= (adminUser && adminUser.fullName) ? adminUser.fullName : "Quản Trị Viên"
          if adminUser && adminUser.role
            span.admin-user-role= adminUser.role.charAt(0).toUpperCase() + adminUser.role.slice(1)

        i.fas.fa-chevron-down

      .admin-user-dropdown#adminUserDropdown

        a(href="/admin/profile")
          i.fas.fa-user
          | Hồ sơ cá nhân

        a(href="/admin/settings")
          i.fas.fa-gear
          | Cài đặt

        .admin-user-dropdown-divider

        a.admin-logout-link(href="/admin/logout")
          i.fas.fa-right-from-bracket
          | Đăng xuất


  //- =========================================================
  //- CSS TRỰC TIẾP - FIX ẢNH ĐẠI DIỆN
  //- =========================================================
  style.
    /* Avatar style */
    #adminAvatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #e8ecf1;
      display: inline-block;
      background: linear-gradient(135deg, #5200c9, #7a3fe0);
    }
    
    /* Nếu ảnh lỗi, hiển thị chữ cái đầu */
    #adminAvatar[src="/admin/image/avatar-default.png"] {
      background: linear-gradient(135deg, #5200c9, #7a3fe0);
      border-color: #5200c9;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
      font-size: 16px;
    }