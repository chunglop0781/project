header.admin-topbar

  //- =========================================================
  //- BÊN TRÁI
  //- =========================================================

  .admin-topbar-left

    button.admin-sidebar-toggle#adminSidebarToggle(type="button" aria-label="Menu")
      i.fas.fa-bars

    h1.admin-topbar-title= pageTitle || "Tổng Quan"


  //- =========================================================
  //- BÊN PHẢI
  //- =========================================================

  .admin-topbar-right

    button.admin-topbar-icon(type="button" aria-label="Thông báo")
      i.fas.fa-bell
      if typeof notificationCount !== "undefined" && notificationCount > 0
        span.admin-topbar-dot

    .admin-user-menu

      button.admin-user-trigger#adminUserTrigger(type="button")

        img.admin-user-avatar(
          src=(adminUser && adminUser.avatar) ? adminUser.avatar : "/admin/image/avatar-default.png"
          alt=(adminUser && adminUser.fullName) ? adminUser.fullName : "Admin"
        )

        //- =====================================================
        //- THÔNG TIN USER
        //- =====================================================
        .admin-user-info
          span.admin-user-name= (adminUser && adminUser.fullName) ? adminUser.fullName : "Quản Trị Viên"
          if adminUser && adminUser.role
            span.admin-user-role= adminUser.role.charAt(0).toUpperCase() + adminUser.role.slice(1)

        i.fas.fa-chevron-down

      .admin-user-dropdown#adminUserDropdown

        a(href="/admin/profile")
          i.fas.fa-user
          | Hồ sơ cá nhân

        a(href="/admin/settings")
          i.fas.fa-gear
          | Cài đặt

        .admin-user-dropdown-divider

        a.admin-logout-link(href="/logout")
          i.fas.fa-right-from-bracket
          | Đăng xuất