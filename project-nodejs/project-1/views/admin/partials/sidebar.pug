aside.admin-sidebar#adminSidebar

  //- =========================================================
  //- LOGO
  //- =========================================================

  .admin-sidebar-logo

    a(href="/admin/dashboard")
      img(src="/admin/image/logo.png" alt="28 Travel")

    button.admin-sidebar-close#adminSidebarClose(type="button" aria-label="Đóng menu")
      i.fas.fa-xmark


  //- =========================================================
  //- MENU
  //- =========================================================

  nav.admin-sidebar-nav

    ul

      li

        a(
          href="/admin/dashboard"
          class=(activeMenu === "dashboard" ? "active" : "")
        )

          i.fas.fa-gauge-high

          span Tổng Quan


      li

        a(
          href="/admin/tours"
          class=(activeMenu === "tours" ? "active" : "")
        )

          i.fas.fa-suitcase-rolling

          span Quản Lý Tour


      //- ✅ THÊM: QUẢN LÝ DANH MỤC
      li

        a(
          href="/admin/categories"
          class=(activeMenu === "categories" ? "active" : "")
        )

          i.fas.fa-tags

          span Quản Lý Danh Mục


      li

        a(
          href="/admin/orders"
          class=(activeMenu === "orders" ? "active" : "")
        )

          i.fas.fa-receipt

          span Đơn Hàng

          if typeof pendingOrderCount !== "undefined" && pendingOrderCount > 0
            span.admin-sidebar-badge= pendingOrderCount


      li

        a(
          href="/admin/customers"
          class=(activeMenu === "customers" ? "active" : "")
        )

          i.fas.fa-users

          span Khách Hàng


      li

        a(
          href="/admin/news"
          class=(activeMenu === "news" ? "active" : "")
        )

          i.fas.fa-newspaper

          span Tin Tức


      li

        a(
          href="/admin/profile"
          class=(activeMenu === "profile" ? "active" : "")
        )

          i.fas.fa-user

          span Thông tin cá nhân


      li

        a(
          href="/admin/settings"
          class=(activeMenu === "settings" ? "active" : "")
        )

          i.fas.fa-gear

          span Cài Đặt


    .admin-sidebar-divider


    ul

      li

        a(href="/" target="_blank")

          i.fas.fa-arrow-up-right-from-square

          span Xem Website


      li

        a.admin-logout-link(href="/admin/logout")

          i.fas.fa-right-from-bracket

          span Đăng Xuất