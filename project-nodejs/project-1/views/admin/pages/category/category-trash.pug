extends ../../layouts/admin-layout.pug

block content

  //- =============================================================
  //- Biến truyền vào (ví dụ):
  //-   categories : [{
  //-     id, name, image, position, status, statusLabel,
  //-     createdByName, createdAt, deletedByName, deletedAt
  //-   }]
  //-   currentPage, totalPages
  //- =============================================================

  .admin-page-head

    div

      h2.admin-page-title Thùng Rác Danh Mục

      p.admin-page-subtitle Các danh mục đã bị xóa, có thể khôi phục hoặc xóa vĩnh viễn.

    a.admin-btn.admin-btn-outline(href="/admin/categories")
      i.fas.fa-arrow-left
      |  Quay lại danh sách danh mục


  .admin-card

    //- ===============================================================
    //- TOOLBAR: HÀNH ĐỘNG HÀNG LOẠT + TÌM KIẾM
    //- ===============================================================

    .admin-toolbar

      form#trashBulkForm.admin-bulk-form(action="/admin/categories/trash/bulk" method="POST")

        select.admin-select(name="bulkAction")

          option(value="") -- Hành động --

          option(value="restore") Khôi phục

          option(value="delete") Xóa vĩnh viễn

        button.admin-btn.admin-btn-outline(type="submit") Áp dụng

      form.admin-search-form(action="/admin/categories/trash" method="GET")

        i.fas.fa-magnifying-glass

        input(
          type="text"
          name="keyword"
          placeholder="Tìm kiếm"
          value=(typeof filter !== "undefined" && filter.keyword) ? filter.keyword : ""
        )


    //- ===============================================================
    //- BẢNG DANH SÁCH
    //- ===============================================================

    .admin-table-scroll

      table.admin-table

        thead

          tr

            th(style="width: 36px")
              input.admin-checkbox(type="checkbox" id="checkAllTrashCategories")

            th Tên danh mục

            th Ảnh đại diện

            th Vị trí

            th Trạng thái

            th Tạo bởi

            th Xóa bởi

            th Hành động


        tbody

          if typeof categories !== "undefined" && categories.length

            each category in categories

              tr

                td
                  input.admin-checkbox(type="checkbox" name="ids" value=category.id form="trashBulkForm")

                td= category.name

                td
                  img.admin-table-thumb(src=category.image alt=category.name)

                td= category.position

                td

                  span.admin-badge(class=category.status === "active" ? "is-active" : "is-inactive")
                    = category.statusLabel || (category.status === "active" ? "Hoạt động" : "Tạm dừng")

                td

                  div= category.createdByName

                  span.admin-table-sub= category.createdAt

                td

                  div= category.deletedByName

                  span.admin-table-sub= category.deletedAt

                td

                  button.admin-icon-btn(
                    type="button"
                    data-restore-url="/admin/categories/" + category.id + "/restore"
                    data-confirm="Khôi phục danh mục này?"
                    title="Khôi phục"
                  )
                    i.fas.fa-rotate-left

                  button.admin-icon-btn.admin-icon-btn-danger(
                    type="button"
                    data-delete-url="/admin/categories/" + category.id + "/force"
                    data-confirm="Xóa vĩnh viễn danh mục này? Hành động không thể hoàn tác."
                    title="Xóa vĩnh viễn"
                  )
                    i.fas.fa-trash

          else

            tr

              td.admin-table-empty(colspan="8") Thùng rác trống.


    include ../../partials/pagination.pug

  script.
    // Xử lý nút "Khôi phục"
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-restore-url]');
      if (!btn) return;

      var url = btn.getAttribute('data-restore-url');
      var confirmMsg = btn.getAttribute('data-confirm');

      if (confirmMsg && !window.confirm(confirmMsg)) return;

      fetch(url, { method: 'POST', credentials: 'same-origin' })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.success) {
            window.location.reload();
          } else {
            alert((data && data.message) || 'Khôi phục thất bại, vui lòng thử lại.');
          }
        })
        .catch(function () {
          alert('Có lỗi xảy ra, vui lòng thử lại.');
        });
    });

    // Check all checkbox
    // Lưu ý: các checkbox "ids" nằm trong bảng, KHÔNG lồng trong
    // form#trashBulkForm (chỉ liên kết qua thuộc tính form="trashBulkForm"),
    // nên phải querySelectorAll ở document, không phải bên trong form.
    document.getElementById('checkAllTrashCategories').addEventListener('change', function (e) {
      document.querySelectorAll('input[name="ids"][form="trashBulkForm"]').forEach(function (cb) {
        cb.checked = e.target.checked;
      });
    });

    // Submit hành động hàng loạt (khôi phục / xóa vĩnh viễn) bằng AJAX
    // vì controller trả về JSON { code, message } thay vì redirect.
    document.getElementById('trashBulkForm').addEventListener('submit', function (e) {
      e.preventDefault();

      var form = e.target;
      var bulkAction = form.querySelector('[name="bulkAction"]').value;
      var ids = Array.from(
        document.querySelectorAll('input[name="ids"][form="trashBulkForm"]:checked')
      ).map(function (cb) { return cb.value; });

      if (!bulkAction) {
        alert('Vui lòng chọn một hành động.');
        return;
      }
      if (ids.length === 0) {
        alert('Vui lòng chọn ít nhất một danh mục.');
        return;
      }
      if (bulkAction === 'delete' && !confirm('Xóa vĩnh viễn các danh mục đã chọn? Hành động không thể hoàn tác.')) {
        return;
      }

      fetch(form.getAttribute('action'), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bulkAction: bulkAction, ids: ids })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.code === 'success') {
            window.location.reload();
          } else {
            alert((data && data.message) || 'Có lỗi xảy ra, vui lòng thử lại.');
          }
        })
        .catch(function () {
          alert('Có lỗi xảy ra, vui lòng thử lại.');
        });
    });