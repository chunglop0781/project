extends ../../layouts/admin-layout.pug

block content

  //- =============================================================
  //- Biến truyền vào (ví dụ):
  //-   categories : [{
  //-     id, name, image, position, status, statusLabel,
  //-     createdByName, createdAt, updatedByName, updatedAt
  //-   }]
  //-   creators : [{ id, fullName }]    -> dùng cho bộ lọc "Người tạo"
  //-   filter   : { status, creator, dateFrom, dateTo, keyword }
  //-   currentPage, totalPages
  //- =============================================================

  .admin-page-head

    div

      h2.admin-page-title Quản Lý Danh Mục

      p.admin-page-subtitle Danh sách tất cả các danh mục tour hiện có.

    div(style="display: flex; gap: 10px;")
      a.admin-btn.admin-btn-primary(href="/admin/categories/new")
        i.fas.fa-plus
        |  Tạo mới
      a.admin-btn.admin-btn-outline(href="/admin/categories/trash")
        i.fas.fa-trash
        |  Thùng rác


  .admin-card

    //- ===============================================================
    //- THANH BỘ LỌC
    //- ===============================================================

    form.admin-filter-bar(action="/admin/categories" method="GET")

      .admin-filter-label
        i.fas.fa-filter
        |  Bộ lọc

      select.admin-filter-select(name="status" onchange="this.form.submit()")

        option(value="") Trạng thái

        option(value="active" selected=(typeof filter !== "undefined" && filter.status === "active"))
          | Hoạt động

        option(value="inactive" selected=(typeof filter !== "undefined" && filter.status === "inactive"))
          | Tạm dừng

      select.admin-filter-select(name="creator" onchange="this.form.submit()")

        option(value="") Người tạo

        if typeof creators !== "undefined" && creators.length

          each creator in creators

            option(
              value=creator.id
              selected=(typeof filter !== "undefined" && filter.creator === creator.id)
            )= creator.fullName

      .admin-filter-daterange

        -
          // Format giá trị ngày hiển thị theo dd/mm/yyyy.
          // Nhận cả Date object lẫn string (ISO...), luôn parse về Date thật
          // rồi mới format ra chuỗi hiển thị - tránh in thẳng string thô chưa qua kiểm tra.
          var formatDateDDMMYYYY = function (d) {
            if (!d) return "";
            var date = (d instanceof Date) ? d : new Date(d);
            if (isNaN(date.getTime())) return "";
            var dd = String(date.getDate()).padStart(2, "0");
            var mm = String(date.getMonth() + 1).padStart(2, "0");
            var yyyy = date.getFullYear();
            return dd + "/" + mm + "/" + yyyy;
          };
          // Format ISO (yyyy-mm-dd) - đây là định dạng bắt buộc mà input type="date"
          // của trình duyệt hiểu được, dùng để nạp giá trị lúc focus.
          var formatDateISO = function (d) {
            if (!d) return "";
            var date = (d instanceof Date) ? d : new Date(d);
            if (isNaN(date.getTime())) return "";
            var dd = String(date.getDate()).padStart(2, "0");
            var mm = String(date.getMonth() + 1).padStart(2, "0");
            var yyyy = date.getFullYear();
            return yyyy + "-" + mm + "-" + dd;
          };
          var dateFromValue = (typeof filter !== "undefined") ? formatDateDDMMYYYY(filter.dateFrom) : "";
          var dateToValue = (typeof filter !== "undefined") ? formatDateDDMMYYYY(filter.dateTo) : "";
          var dateFromISO = (typeof filter !== "undefined") ? formatDateISO(filter.dateFrom) : "";
          var dateToISO = (typeof filter !== "undefined") ? formatDateISO(filter.dateTo) : "";

        input.admin-filter-date(
          type="text"
          name="dateFrom"
          placeholder="dd/mm/yyyy"
          value=dateFromValue
          data-iso=dateFromISO
          onfocus="this.removeAttribute('placeholder'); this.type='date'; if(this.dataset.iso) this.value = this.dataset.iso;"
          onblur="if(this.value){ this.dataset.iso = this.value; var p = this.value.split('-'); this.type='text'; this.value = p[2] + '/' + p[1] + '/' + p[0]; } else { this.type='text'; } this.setAttribute('placeholder','dd/mm/yyyy');"
        )

        span -

        input.admin-filter-date(
          type="text"
          name="dateTo"
          placeholder="dd/mm/yyyy"
          value=dateToValue
          data-iso=dateToISO
          onfocus="this.removeAttribute('placeholder'); this.type='date'; if(this.dataset.iso) this.value = this.dataset.iso;"
          onblur="if(this.value){ this.dataset.iso = this.value; var p = this.value.split('-'); this.type='text'; this.value = p[2] + '/' + p[1] + '/' + p[0]; } else { this.type='text'; } this.setAttribute('placeholder','dd/mm/yyyy');"
        )

      button.admin-btn.admin-btn-outline(type="submit")
        i.fas.fa-filter
        |  Lọc

      button.admin-btn.admin-btn-text(type="submit")
        i.fas.fa-magnifying-glass
        | Áp dụng

      a.admin-filter-clear(href="/admin/categories")
        i.fas.fa-rotate-left
        |  Xóa bộ lọc


    //- ===============================================================
    //- TOOLBAR: HÀNH ĐỘNG HÀNG LOẠT + TÌM KIẾM
    //- ===============================================================

    .admin-toolbar

      .admin-bulk-bar
        select#categoryBulkAction(name="bulkAction" form="categoryBulkForm")
          option(value="") -- Hành động --
          option(value="activate") Kích hoạt
          option(value="deactivate") Tạm dừng
          option(value="delete") Chuyển vào thùng rác
        button.admin-btn.admin-btn-primary(
          type="submit"
          form="categoryBulkForm"
          onclick="return confirm('Bạn có chắc muốn thực hiện hành động này với các danh mục đã chọn?');"
        )
          i.fas.fa-bolt
          |  Thực hiện

      form.admin-search-form(action="/admin/categories" method="GET")

        i.fas.fa-magnifying-glass

        input(
          type="text"
          name="keyword"
          placeholder="Tìm kiếm"
          value=(typeof filter !== "undefined" && filter.keyword) ? filter.keyword : ""
        )


    //- ===============================================================
    //- BẢNG DANH SÁCH
    //- ===============================================================

    form#categoryBulkForm.admin-table-scroll(action="/admin/categories/bulk" method="POST")

      table.admin-table

        thead

          tr

            th(style="width: 36px")
              input.admin-checkbox(type="checkbox" id="checkAllCategories")

            th Tên danh mục

            th Ảnh đại diện

            th Vị trí

            th Trạng thái

            th Tạo bởi

            th Cập nhật bởi

            th Hành động


        tbody

          if typeof categories !== "undefined" && categories.length

            each category in categories

              tr

                td
                  input.admin-checkbox(type="checkbox" name="ids" value=category.id)

                td= category.name

                td
                  img.admin-table-thumb(src=category.image alt=category.name)

                td= category.position

                td

                  span.admin-badge(class=category.status === "active" ? "is-active" : "is-inactive")
                    = category.statusLabel || (category.status === "active" ? "Hoạt động" : "Tạm dừng")

                td

                  div= category.createdByName

                  span.admin-table-sub= category.createdAt

                td

                  //- ✅ ĐÃ SỬA: Dùng updatedByName (đồng bộ với controller)
                  div= category.updatedByName || 'N/A'
                  span.admin-table-sub= category.updatedAt

                td

                  a.admin-icon-btn(href="/admin/categories/" + category.id + "/edit" title="Sửa")
                    i.fas.fa-pen

                  button.admin-icon-btn.admin-icon-btn-danger(
                    type="button"
                    data-delete-url="/admin/categories/" + category.id
                    data-confirm="Bạn có chắc muốn xóa danh mục này?"
                    title="Xóa"
                  )
                    i.fas.fa-trash

          else

            tr

              td.admin-table-empty(colspan="8") Chưa có danh mục nào.


    include ../../partials/pagination.pug

  script.
    // Tick "chọn tất cả" trong bảng danh sách chính
    document.getElementById('checkAllCategories').addEventListener('change', function (e) {
      document.querySelectorAll('#categoryBulkForm input[name="ids"]').forEach(function (cb) {
        cb.checked = e.target.checked;
      });
    });

    // Submit hành động hàng loạt bằng AJAX (controller trả về JSON { code, message })
    document.getElementById('categoryBulkForm').addEventListener('submit', function (e) {
      e.preventDefault();

      var form = e.target;
      var bulkAction = document.getElementById('categoryBulkAction').value;
      var ids = Array.from(form.querySelectorAll('input[name="ids"]:checked')).map(function (cb) {
        return cb.value;
      });

      if (!bulkAction) {
        alert('Vui lòng chọn một hành động.');
        return;
      }
      if (ids.length === 0) {
        alert('Vui lòng chọn ít nhất một danh mục.');
        return;
      }

      fetch(form.getAttribute('action'), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bulkAction: bulkAction, ids: ids })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.code === 'success') {
            window.location.reload();
          } else {
            alert((data && data.message) || 'Có lỗi xảy ra, vui lòng thử lại.');
          }
        })
        .catch(function () {
          alert('Có lỗi xảy ra, vui lòng thử lại.');
        });
    });
