extends ../../layouts/admin-layout.pug

block content
  .admin-page-head
    div
      h2.admin-page-title= (typeof category !== "undefined" && category) ? "Sửa Danh Mục" : "Tạo Danh Mục"
      p.admin-page-subtitle Điền đầy đủ thông tin bên dưới.

    a.admin-btn.admin-btn-outline(href="/admin/categories")
      i.fas.fa-arrow-left
      |  Quay lại danh sách

  if typeof error !== "undefined" && error
    .admin-alert.admin-alert-error
      i.fas.fa-circle-exclamation
      span= error

  .admin-card
    form.admin-form(
      method="POST"
      action=(typeof category !== "undefined" && category) ? "/admin/categories/" + category.id + "/edit" : "/admin/categories/new"
      enctype="multipart/form-data"
    )
      .admin-form-grid
        .admin-form-col
          .admin-form-row
            .admin-form-group
              label(for="name") Tên danh mục *
              input#name.admin-input(
                type="text"
                name="name"
                value=(typeof category !== "undefined" && category) ? category.name : ""
                placeholder="VD: Tour Biển"
                required
              )

            .admin-form-group
              label(for="parent") Danh mục cha
              select#parent.admin-input(name="parent")
                option(value="") -- Chọn danh mục --
                if typeof parentCategories !== "undefined" && parentCategories.length
                  each parent in parentCategories
                    option(
                      value=parent.id
                      selected=(typeof category !== "undefined" && category && category.parent === parent.id)
                    )= parent.name

          .admin-form-row
            .admin-form-group
              label(for="position") Vị trí
              input#position.admin-input(
                type="number"
                name="position"
                min="1"
                value=(typeof category !== "undefined" && category) ? category.position : ""
                placeholder="1"
              )

            .admin-form-group
              label(for="status") Trạng thái
              select#status.admin-input(name="status")
                option(value="active" selected=(typeof category !== "undefined" && category && category.status === "active")) Hoạt động
                option(value="inactive" selected=(typeof category !== "undefined" && category && category.status === "inactive")) Dừng hoạt động

          .admin-form-group
            label(for="description") Mô tả
            textarea#description.tinymce-editor(
              name="description"
              rows="10"
              placeholder="Mô tả chi tiết về danh mục..."
            )= (typeof category !== "undefined" && category) ? category.description : ""

        .admin-form-col.admin-form-col-side
          .admin-form-group
            label Ảnh đại diện
            .admin-form-image-preview#categoryImagePreview
              img(
                src=(typeof category !== "undefined" && category && category.image) ? category.image : "/admin/image/no-image.png"
                alt="Ảnh danh mục"
              )
            input#image.admin-input(
              type="file"
              name="image"
              accept="image/*"
            )
            p.admin-form-hint Chưa chọn ảnh mới sẽ giữ nguyên ảnh cũ (khi sửa).

      .admin-form-actions
        button.admin-btn.admin-btn-primary(type="submit")
          i.fas.fa-floppy-disk
          |  #{(typeof category !== "undefined" && category) ? "Cập nhật" : "Tạo mới"}
        a.admin-btn.admin-btn-outline(href="/admin/categories") Hủy

block scripts
  script(src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.3/tinymce.min.js")
  script(src="/admin/assets/js/tinymce-config.js")
  script.
    (function() {
      var imageInput = document.querySelector('#image');
      var preview = document.querySelector('#categoryImagePreview img');
      if (!imageInput || !preview) return;
      imageInput.addEventListener('change', function() {
        var file = this.files && this.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    })();