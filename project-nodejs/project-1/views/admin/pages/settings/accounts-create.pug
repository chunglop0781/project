extends ../../layouts/admin-layout.pug

block content

  .admin-page-head
    div
      h2.admin-page-title Tạo tài khoản quản trị
      p.admin-page-subtitle Thêm tài khoản quản trị mới vào hệ thống.

    a.admin-btn.admin-btn-outline(href="/admin/settings/accounts")
      i.fa-solid.fa-arrow-left
      |  Quay lại danh sách


  .admin-card

    if error
      .admin-alert.admin-alert-danger
        i.fa-solid.fa-circle-exclamation
        |  #{error}


    form.admin-form(
      action="/admin/settings/accounts/create"
      method="POST"
    )

      // =====================================================
      // HỌ TÊN + EMAIL
      // =====================================================

      .admin-form-row

        .admin-form-group
          label.admin-form-label(for="fullName")
            | Họ tên

          input.admin-form-input#fullName(
            type="text"
            name="fullName"
            placeholder="Nhập họ tên"
            required
          )

        .admin-form-group
          label.admin-form-label(for="email")
            | Email

          input.admin-form-input#email(
            type="email"
            name="email"
            placeholder="Nhập email"
            required
          )


      // =====================================================
      // SỐ ĐIỆN THOẠI + CHỨC VỤ
      // =====================================================

      .admin-form-row

        .admin-form-group
          label.admin-form-label(for="phone")
            | Số điện thoại

          input.admin-form-input#phone(
            type="text"
            name="phone"
            placeholder="Ví dụ: +84352417216"
          )

        .admin-form-group
          label.admin-form-label(for="position")
            | Chức vụ

          input.admin-form-input#position(
            type="text"
            name="position"
            placeholder="Ví dụ: Quản trị hệ thống"
          )


      // =====================================================
      // NHÓM QUYỀN + TRẠNG THÁI
      // =====================================================

      .admin-form-row

        .admin-form-group
          label.admin-form-label(for="role")
            | Nhóm quyền

          select.admin-form-input#role(
            name="role"
            required
          )

            option(value="")
              | -- Chọn nhóm quyền --

            option(value="admin")
              | Quản trị viên

            option(value="tour-manager")
              | Quản lý tour

            option(value="order-manager")
              | Quản lý đơn hàng


        .admin-form-group
          label.admin-form-label(for="status")
            | Trạng thái

          select.admin-form-input#status(
            name="status"
          )

            option(value="active")
              | Hoạt động

            option(value="inactive")
              | Tạm dừng


      // =====================================================
      // ĐỊA CHỈ
      // =====================================================

      .admin-form-row

        .admin-form-group
          label.admin-form-label(for="address")
            | Địa chỉ

          input.admin-form-input#address(
            type="text"
            name="address"
            placeholder="Nhập địa chỉ"
          )


      // =====================================================
      // MẬT KHẨU
      // =====================================================

      .admin-form-row

        .admin-form-group
          label.admin-form-label(for="password")
            | Mật khẩu

          input.admin-form-input#password(
            type="password"
            name="password"
            placeholder="Nhập mật khẩu"
            required
          )

        .admin-form-group
          label.admin-form-label(for="confirmPassword")
            | Nhập lại mật khẩu

          input.admin-form-input#confirmPassword(
            type="password"
            name="confirmPassword"
            placeholder="Nhập lại mật khẩu"
            required
          )


      // =====================================================
      // BUTTON
      // =====================================================

      .admin-form-actions

        a.admin-btn.admin-btn-outline(
          href="/admin/settings/accounts"
        )
          | Hủy

        button.admin-btn.admin-btn-primary(
          type="submit"
        )
          i.fa-solid.fa-check
          |  Tạo tài khoản


  // =========================================================
  // KIỂM TRA MẬT KHẨU
  // =========================================================

  script.
    document
      .querySelector('.admin-form')
      .addEventListener('submit', function(e) {

        const password =
          document.getElementById('password').value;

        const confirmPassword =
          document.getElementById('confirmPassword').value;

        if (
          password !== confirmPassword
        ) {
          e.preventDefault();

          alert(
            'Mật khẩu nhập lại không khớp!'
          );
        }

      });