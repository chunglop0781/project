extends ../../layouts/admin-layout.pug

block content
  .admin-page-head
    div
      h2.admin-page-title= typeof pageTitle !== "undefined" ? pageTitle : "Sửa Khách Hàng"
      p.admin-page-subtitle Cập nhật thông tin khách hàng.

    div(style="display: flex; gap: 10px;")
      a.admin-btn.admin-btn-outline(href="/admin/customers/" + customer.id)
        i.fas.fa-arrow-left
        |  Quay lại chi tiết

  if typeof error !== "undefined" && error
    .admin-alert.admin-alert-error
      i.fas.fa-circle-exclamation
      span= error

  .admin-card
    form#customerForm.admin-form(
      method="POST"
      action="/admin/customers/" + customer.id + "/edit"
      enctype="multipart/form-data"
    )
      .admin-form-grid
        .admin-form-col
          .admin-form-row
            .admin-form-group
              label(for="name") Họ và tên *
              input#name.admin-input(
                type="text"
                name="name"
                value=customer.name
                placeholder="VD: Nguyễn Văn A"
                required
              )

            .admin-form-group
              label(for="phone") Số điện thoại *
              input#phone.admin-input(
                type="text"
                name="phone"
                value=customer.phone
                placeholder="VD: 0912345678"
                required
              )

          .admin-form-row
            .admin-form-group
              label(for="email") Email
              input#email.admin-input(
                type="email"
                name="email"
                value=customer.email
                placeholder="VD: customer@example.com"
              )

            .admin-form-group
              label(for="status") Trạng thái
              select#status.admin-input(name="status")
                option(value="active" selected=(customer.status === "active")) Hoạt động
                option(value="inactive" selected=(customer.status === "inactive")) Tạm dừng

          .admin-form-group
            label(for="address") Địa chỉ
            textarea#address.admin-input(
              name="address"
              rows="3"
              placeholder="VD: Số 123, Đường ABC, Quận XYZ, TP.HCM"
            )= customer.address

          //- ===============================================================
          //- VAI TRÒ (ROLE) - CHỈ ADMIN MỚI ĐƯỢC XEM/SỬA
          //- Cho phép gõ role mới chưa từng có trong hệ thống (datalist chỉ
          //- gợi ý, không giới hạn giá trị được nhập).
          //- ===============================================================
          if typeof currentUserRole !== "undefined" && currentUserRole === "admin"
            .admin-form-row
              .admin-form-group
                label(for="role") Vai trò (role)
                input#role.admin-input(
                  type="text"
                  name="role"
                  list="roleList"
                  value=customer.role
                  placeholder="VD: admin, customer, staff..."
                )
                datalist#roleList
                  option(value="admin")
                  option(value="customer")
                  option(value="staff")
                p.admin-form-hint Chỉ quản trị viên (admin) mới thấy và sửa được trường này. Có thể gõ một vai trò mới nếu hệ thống chưa có.

        .admin-form-col.admin-form-col-side
          .admin-form-group
            label Ảnh đại diện
            .admin-form-image-preview#avatarPreview
              img(
                src=customer.avatar || '/admin/image/no-image.png'
                alt="Ảnh đại diện"
                onerror="this.src='/admin/image/no-image.png'"
              )
            input#avatar.admin-input(
              type="file"
              name="avatar"
              accept="image/*"
            )
            p.admin-form-hint Chọn ảnh mới để thay đổi ảnh đại diện.

      .admin-form-actions
        button.admin-btn.admin-btn-primary(type="submit")
          i.fas.fa-floppy-disk
          |  Cập nhật
        a.admin-btn.admin-btn-outline(href="/admin/customers/" + customer.id) Hủy

block scripts
  script.
    (function() {
      // Preview ảnh khi chọn file
      var avatarInput = document.querySelector('#avatar');
      var preview = document.querySelector('#avatarPreview img');
      if (avatarInput && preview) {
        avatarInput.addEventListener('change', function() {
          var file = this.files && this.files[0];
          if (!file) return;
          var reader = new FileReader();
          reader.onload = function(e) {
            preview.src = e.target.result;
          };
          reader.readAsDataURL(file);
        });
      }

      // Debug form submit
      var form = document.getElementById('customerForm');
      if (form) {
        console.log('✅ Customer edit form found');
        form.addEventListener('submit', function(e) {
          console.log('🔍 FORM SUBMIT EVENT FIRED');
          console.log('  - Action:', form.action);
          console.log('  - Method:', form.method);
          console.log('  - Enctype:', form.enctype);
          
          var formData = new FormData(form);
          console.log('📝 FORM DATA:');
          for (var pair of formData.entries()) {
            console.log('  - ' + pair[0] + ':', pair[1]);
          }
          return true;
        });
      }
    })();