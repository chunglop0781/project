extends ../../layouts/admin-layout.pug

block content

  .admin-page-head

    div

      h2.admin-page-title Quản Lý Danh Mục

      p.admin-page-subtitle Danh sách tất cả các danh mục tour du lịch.

    .admin-page-head-actions

      a.admin-btn.admin-btn-primary(href="/admin/categories/new")
        i.fas.fa-plus
        |  Tạo mới


  .admin-card

    //- ===============================================================
    //- THANH BỘ LỌC
    //- ===============================================================

    form.admin-filter-bar(action="/admin/categories" method="GET")

      .admin-filter-label
        i.fas.fa-filter
        |  Bộ lọc

      select.admin-filter-select(name="status")

        option(value="") Trạng thái

        option(value="active" selected=(filter && filter.status === "active")) Hoạt động

        option(value="inactive" selected=(filter && filter.status === "inactive")) Tạm dừng

      .admin-filter-daterange

        input.admin-filter-date(
          type="text"
          name="dateFrom"
          placeholder="dd/mm/yyyy"
          value=(filter && filter.dateFrom) ? filter.dateFrom : ""
        )

        span -

        input.admin-filter-date(
          type="text"
          name="dateTo"
          placeholder="dd/mm/yyyy"
          value=(filter && filter.dateTo) ? filter.dateTo : ""
        )

      button.admin-btn.admin-btn-text(type="submit") Áp dụng

      a.admin-filter-clear(href="/admin/categories")
        i.fas.fa-rotate-left
        |  Xóa bộ lọc


    //- ===============================================================
    //- TOOLBAR: HÀNH ĐỘNG HÀNG LOẠT + TÌM KIẾM
    //- ===============================================================

    .admin-toolbar

      form.admin-bulk-form(action="/admin/categories/bulk" method="POST")

        select.admin-select(name="bulkAction")

          option(value="") -- Hành động --

          option(value="activate") Kích hoạt

          option(value="deactivate") Tạm dừng

          option(value="delete") Xóa

        button.admin-btn.admin-btn-outline(type="submit") Áp dụng

      form.admin-search-form(action="/admin/categories" method="GET")

        i.fas.fa-magnifying-glass

        input(
          type="text"
          name="keyword"
          placeholder="Tìm kiếm"
          value=(filter && filter.keyword) ? filter.keyword : ""
        )


    //- ===============================================================
    //- BẢNG DANH SÁCH
    //- ===============================================================

    .admin-table-wrap

      table.admin-table

        thead

          tr

            th(style="width: 36px")
              input.admin-checkbox(type="checkbox" id="checkAllCategories")

            th Tên danh mục

            th Ảnh

            th Vị trí

            th Trạng thái

            th Mô tả

            th Người tạo

            th Ngày tạo

            th Hành động


        tbody

          if categories && categories.length

            each category in categories

              tr

                td
                  input.admin-checkbox(type="checkbox" name="ids" value=category.id)

                td= category.name

                td
                  img.admin-table-thumb(src=category.image alt=category.name)

                td= category.position || 0

                td
                  span.admin-badge(class=category.status === "active" ? "is-active" : "is-inactive")
                    = category.statusLabel

                td= category.description ? category.description.substring(0, 50) + (category.description.length > 50 ? "..." : "") : ""

                td= category.createdByName

                td= category.createdAt

                td

                  a.admin-icon-btn(href="/admin/categories/" + category.id + "/edit" title="Sửa")
                    i.fas.fa-pen

                  button.admin-icon-btn.admin-icon-btn-danger(
                    type="button"
                    data-delete-url="/admin/categories/" + category.id
                    data-confirm="Bạn có chắc muốn xóa danh mục này?"
                    title="Xóa"
                  )
                    i.fas.fa-trash

          else

            tr

              td.admin-table-empty(colspan="9") Chưa có danh mục nào.