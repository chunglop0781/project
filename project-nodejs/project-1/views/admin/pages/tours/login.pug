extends ../layouts/auth-layout.pug

block content

  .admin-auth-wrapper

    .admin-auth-card

      .admin-auth-logo

        img(src="/assets/image/logo.png" alt="28 Travel")

        h1 28 Travel Admin

        p Đăng nhập để quản lý hệ thống


      if typeof error !== "undefined" && error

        .admin-alert.admin-alert-error

          i.fas.fa-circle-exclamation

          span= error


      form.admin-auth-form(action="/admin/login" method="POST")

        .admin-form-group

          label(for="admin-username") Tên đăng nhập hoặc Email

          .admin-input-icon

            i.fas.fa-user

            input#admin-username(
              type="text"
              name="username"
              placeholder="Nhập tên đăng nhập"
              autocomplete="username"
              required
            )


        .admin-form-group

          label(for="admin-password") Mật khẩu

          .admin-input-icon

            i.fas.fa-lock

            input#admin-password(
              type="password"
              name="password"
              placeholder="Nhập mật khẩu"
              autocomplete="current-password"
              required
            )

            button.admin-password-toggle(type="button" aria-label="Hiện mật khẩu")
              i.fas.fa-eye


        .admin-auth-row

          label.admin-checkbox

            input(type="checkbox" name="remember")

            span.admin-checkbox-box

            | Ghi nhớ đăng nhập

          a(href="/admin/forgot-password") Quên mật khẩu?


        button.admin-auth-submit(type="submit")

          i.fas.fa-right-to-bracket

          | Đăng Nhập


      a.admin-auth-back(href="/")

        i.fas.fa-arrow-left

        | Về trang chủ website
