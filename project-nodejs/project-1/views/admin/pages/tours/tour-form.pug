block scripts

  script(src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.3/tinymce.min.js")

  script(src="/admin/assets/js/tinymce-config.js")

  - var initialDescription = (typeof tour !== "undefined" && tour) ? (tour.description || "") : ""

  script.
    (function () {

      document.addEventListener('DOMContentLoaded', function () {

        // ==========================================================
        // TINYMCE - THÔNG TIN TOUR (info_tour)
        // ==========================================================

        tinymce.init({

          selector: '#info_tour',

          height: 300,

          menubar: true,

          plugins:
            'lists link image table code',

          toolbar:
            'undo redo | blocks | bold italic underline strikethrough | ' +
            'alignleft aligncenter alignright alignjustify | ' +
            'bullist numlist | outdent indent | ' +
            'link image table | code',

          branding: false,

          promotion: false,

          statusbar: true,

          setup: function (editor) {

            editor.on('change keyup', function () {

              editor.save();

            });

          }

        });

        const container =
          document.getElementById('itineraryContainer');

        const addButton =
          document.getElementById('addItineraryBtn');

        const hiddenDescription =
          document.getElementById('description');

        const form =
          document.querySelector('form.admin-form');


        if (!container || !addButton || !hiddenDescription || !form) {
          return;
        }


        let itineraryIndex = 0;


        // ==========================================================
        // DESCRIPTION BAN ĐẦU
        // ==========================================================

        const initialDescription = !{JSON.stringify(initialDescription)};


        // ==========================================================
        // TẠO MỘT NGÀY
        // ==========================================================

        function createItineraryItem(title, content) {

          itineraryIndex++;


          const item =
            document.createElement('div');

          item.className =
            'itinerary-item';


          item.style.border =
            '1px solid #e2e5ea';

          item.style.borderRadius =
            '8px';

          item.style.marginBottom =
            '16px';

          item.style.overflow =
            'hidden';

          item.style.background =
            '#fff';


          // --------------------------------------------------------
          // HEADER
          // --------------------------------------------------------

          const header =
            document.createElement('div');

          header.className =
            'itinerary-header';

          header.style.display =
            'flex';

          header.style.alignItems =
            'center';

          header.style.gap =
            '10px';

          header.style.padding =
            '10px';

          header.style.background =
            '#f7f8fa';

          header.style.borderBottom =
            '1px solid #e2e5ea';


          // --------------------------------------------------------
          // NÚT KÉO
          // --------------------------------------------------------

          const dragButton =
            document.createElement('button');

          dragButton.type =
            'button';

          dragButton.className =
            'itinerary-drag';

          dragButton.title =
            'Kéo để sắp xếp';

          dragButton.innerHTML =
            '<i class="fas fa-arrows-up-down"></i>';

          dragButton.style.width =
            '40px';

          dragButton.style.height =
            '40px';

          dragButton.style.border =
            '1px solid #e2e5ea';

          dragButton.style.background =
            '#fff';

          dragButton.style.borderRadius =
            '6px';


          // --------------------------------------------------------
          // TIÊU ĐỀ
          // --------------------------------------------------------

          const titleInput =
            document.createElement('input');

          titleInput.type =
            'text';

          titleInput.className =
            'admin-input itinerary-title';

          titleInput.value =
            title || ('Ngày ' + itineraryIndex);

          titleInput.placeholder =
            'Tiêu đề lịch trình';

          titleInput.style.flex =
            '1';


          // --------------------------------------------------------
          // NÚT XÓA
          // --------------------------------------------------------

          const deleteButton =
            document.createElement('button');

          deleteButton.type =
            'button';

          deleteButton.className =
            'admin-btn admin-btn-outline itinerary-delete';

          deleteButton.title =
            'Xóa';

          deleteButton.innerHTML =
            '<i class="fas fa-trash"></i>';

          deleteButton.style.minWidth =
            '40px';

          deleteButton.style.height =
            '40px';


          // --------------------------------------------------------
          // NÚT THU GỌN
          // --------------------------------------------------------

          const collapseButton =
            document.createElement('button');

          collapseButton.type =
            'button';

          collapseButton.className =
            'admin-btn admin-btn-outline itinerary-collapse';

          collapseButton.title =
            'Thu gọn';

          collapseButton.innerHTML =
            '<i class="fas fa-chevron-down"></i>';

          collapseButton.style.minWidth =
            '40px';

          collapseButton.style.height =
            '40px';


          header.appendChild(dragButton);

          header.appendChild(titleInput);

          header.appendChild(deleteButton);

          header.appendChild(collapseButton);


          // --------------------------------------------------------
          // KHU VỰC EDITOR
          // --------------------------------------------------------

          const editorWrapper =
            document.createElement('div');

          editorWrapper.className =
            'itinerary-editor';

          editorWrapper.style.padding =
            '10px';


          const textarea =
            document.createElement('textarea');

          textarea.id =
            'itinerary_' + itineraryIndex;

          textarea.rows =
            8;

          textarea.placeholder =
            'Nhập nội dung lịch trình...';

          textarea.value =
            content || '';

          textarea.style.width =
            '100%';


          editorWrapper.appendChild(textarea);

          item.appendChild(header);

          item.appendChild(editorWrapper);

          container.appendChild(item);


          // ========================================================
          // TINYMCE
          // ========================================================

          tinymce.init({

            target: textarea,

            height: 300,

            menubar: true,

            plugins:
              'lists link image table code',

            toolbar:
              'undo redo | blocks | bold italic underline strikethrough | ' +
              'alignleft aligncenter alignright alignjustify | ' +
              'bullist numlist | outdent indent | ' +
              'link image table | code',

            branding: false,

            promotion: false,

            statusbar: true,

            setup: function (editor) {

              editor.on('change keyup', function () {

                editor.save();

              });

            }

          });


          // ========================================================
          // XÓA NGÀY
          // ========================================================

          deleteButton.addEventListener(
            'click',
            function () {

              const editor =
                tinymce.get(textarea.id);


              if (editor) {

                editor.remove();

              }


              item.remove();

              updateTitles();

            }
          );


          // ========================================================
          // THU GỌN / MỞ RỘNG
          // ========================================================

          collapseButton.addEventListener(
            'click',
            function () {

              const icon =
                collapseButton.querySelector('i');


              if (
                editorWrapper.style.display === 'none'
              ) {

                editorWrapper.style.display =
                  '';

                icon.className =
                  'fas fa-chevron-down';

              } else {

                editorWrapper.style.display =
                  'none';

                icon.className =
                  'fas fa-chevron-right';

              }

            }
          );


          return item;

        }


        // ==========================================================
        // CẬP NHẬT TIÊU ĐỀ
        // ==========================================================

        function updateTitles() {

          const items =
            container.querySelectorAll(
              '.itinerary-item'
            );


          items.forEach(
            function (item, index) {

              const titleInput =
                item.querySelector(
                  '.itinerary-title'
                );


              if (
                titleInput &&
                !titleInput.value.trim()
              ) {

                titleInput.value =
                  'Ngày ' + (index + 1);

              }

            }
          );

        }


        // ==========================================================
        // ĐỌC DESCRIPTION
        // ==========================================================

        function parseDescription(value) {

          if (!value) {

            return [];

          }


          try {

            const parsed =
              JSON.parse(value);


            if (Array.isArray(parsed)) {

              return parsed;

            }

          } catch (error) {

            // Dữ liệu description cũ
            // không phải JSON.
            // Đưa toàn bộ vào Ngày 1.

          }


          return [
            {
              title: 'Ngày 1',
              content: value
            }
          ];

        }


        // ==========================================================
        // LOAD DỮ LIỆU CŨ
        // ==========================================================

        const itineraryData =
          parseDescription(initialDescription);


        if (itineraryData.length > 0) {

          itineraryData.forEach(
            function (item, index) {

              createItineraryItem(

                item.title ||
                ('Ngày ' + (index + 1)),

                item.content ||
                ''

              );

            }
          );

        } else {

          // Tạo tour mới
          // => tạo sẵn Ngày 1.

          createItineraryItem(
            'Ngày 1',
            ''
          );

        }


        // ==========================================================
        // NÚT THÊM MÔ TẢ
        // ==========================================================

        addButton.addEventListener(
          'click',
          function () {

            createItineraryItem();

            updateTitles();


            setTimeout(
              function () {

                const items =
                  container.querySelectorAll(
                    '.itinerary-item'
                  );


                const lastItem =
                  items[items.length - 1];


                if (lastItem) {

                  lastItem.scrollIntoView({

                    behavior: 'smooth',

                    block: 'center'

                  });

                }

              },
              300
            );

          }
        );


        // ==========================================================
        // SUBMIT FORM
        // ==========================================================

        form.addEventListener(
          'submit',
          function () {

            // Đồng bộ TinyMCE vào textarea.

            tinymce.triggerSave();


            const items =
              container.querySelectorAll(
                '.itinerary-item'
              );


            const itinerary = [];


            items.forEach(
              function (item) {

                const titleInput =
                  item.querySelector(
                    '.itinerary-title'
                  );


                const textarea =
                  item.querySelector(
                    'textarea'
                  );


                if (!textarea) {

                  return;

                }


                const editor =
                  tinymce.get(
                    textarea.id
                  );


                const content =
                  editor
                    ? editor.getContent()
                    : textarea.value;


                const title =
                  titleInput
                    ? titleInput.value.trim()
                    : '';


                itinerary.push({

                  title:
                    title ||
                    ('Ngày ' + (itinerary.length + 1)),

                  content:
                    content || ''

                });

              }
            );


            // ======================================================
            // GIỮ NGUYÊN BIẾN DESCRIPTION
            // ======================================================

            hiddenDescription.value =
              JSON.stringify(itinerary);

          }
        );

      });

    })();