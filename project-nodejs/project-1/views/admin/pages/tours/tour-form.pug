extends ../../layouts/admin-layout.pug

block content

  .admin-page-head
    div
      h2.admin-page-title= (typeof tour !== "undefined" && tour) ? "Sửa Tour" : "Tạo Tour"
      p.admin-page-subtitle Điền đầy đủ thông tin bên dưới.

    a.admin-btn.admin-btn-outline(href="/admin/tours")
      i.fas.fa-arrow-left
      |  Quay lại danh sách


  if typeof error !== "undefined" && error

    .admin-alert.admin-alert-error
      i.fas.fa-circle-exclamation
      span= error


  .admin-card

    form.admin-form(
      method="POST"
      action=(typeof tour !== "undefined" && tour) ? "/admin/tours/" + tour.id + "/edit" : "/admin/tours/new"
      enctype="multipart/form-data"
    )

      .admin-form-grid

        .admin-form-col

          .admin-form-row

            .admin-form-group
              label(for="name") Tên tour *

              input#name.admin-input(
                type="text"
                name="name"
                value=(typeof tour !== "undefined" && tour) ? tour.name : ""
                placeholder="VD: Tour Hạ Long"
                required
              )


            .admin-form-group
              label(for="category") Danh mục

              select#category.admin-input(name="category")

                option(value="") -- Chọn danh mục --

                if typeof categories !== "undefined" && categories.length

                  each cat in categories

                    option(
                      value=cat.id
                      selected=(typeof tour !== "undefined" && tour && tour.category === cat.id)
                    )= cat.name


          .admin-form-row

            .admin-form-group
              label(for="code") Mã tour

              input#code.admin-input(
                type="text"
                name="code"
                value=(typeof tour !== "undefined" && tour) ? tour.code : ""
                placeholder="VD: TR001"
              )


            .admin-form-group
              label(for="position") Vị trí

              input#position.admin-input(
                type="number"
                name="position"
                min="1"
                value=(typeof tour !== "undefined" && tour) ? tour.position : ""
                placeholder="1"
              )


            .admin-form-group
              label(for="status") Trạng thái

              select#status.admin-input(name="status")

                option(
                  value="active"
                  selected=(typeof tour !== "undefined" && tour && tour.status === "active")
                ) Hoạt động

                option(
                  value="inactive"
                  selected=(typeof tour !== "undefined" && tour && tour.status === "inactive")
                ) Tạm dừng


          .admin-form-row

            .admin-form-group
              label(for="duration") Thời lượng

              input#duration.admin-input(
                type="text"
                name="duration"
                value=(typeof tour !== "undefined" && tour) ? tour.duration : ""
                placeholder="VD: 3 ngày 2 đêm"
              )


            .admin-form-group
              label(for="vehicle") Phương tiện

              input#vehicle.admin-input(
                type="text"
                name="vehicle"
                value=(typeof tour !== "undefined" && tour) ? tour.vehicle : ""
                placeholder="VD: Ô tô"
              )


            .admin-form-group
              label(for="departureDate") Ngày khởi hành

              input#departureDate.admin-input(
                type="date"
                name="departureDate"
                value=(typeof tour !== "undefined" && tour && tour.departureDate) ? tour.departureDate : ""
              )


          .admin-form-subgrid

            .admin-form-subcol

              h4.admin-form-subtitle Giá cũ

              .admin-form-group
                label(for="oldPriceAdult") Người lớn

                input#oldPriceAdult.admin-input(
                  type="number"
                  min="0"
                  name="oldPriceAdult"
                  value=(typeof tour !== "undefined" && tour) ? tour.oldPriceAdult : ""
                  placeholder="0"
                )


              .admin-form-group
                label(for="oldPriceChild") Trẻ em

                input#oldPriceChild.admin-input(
                  type="number"
                  min="0"
                  name="oldPriceChild"
                  value=(typeof tour !== "undefined" && tour) ? tour.oldPriceChild : ""
                  placeholder="0"
                )


              .admin-form-group
                label(for="oldPriceInfant") Em bé

                input#oldPriceInfant.admin-input(
                  type="number"
                  min="0"
                  name="oldPriceInfant"
                  value=(typeof tour !== "undefined" && tour) ? tour.oldPriceInfant : ""
                  placeholder="0"
                )


            .admin-form-subcol

              h4.admin-form-subtitle Giá mới

              .admin-form-group
                label(for="newPriceAdult") Người lớn

                input#newPriceAdult.admin-input(
                  type="number"
                  min="0"
                  name="newPriceAdult"
                  value=(typeof tour !== "undefined" && tour) ? tour.newPriceAdult : ""
                  placeholder="0"
                  required
                )


              .admin-form-group
                label(for="newPriceChild") Trẻ em

                input#newPriceChild.admin-input(
                  type="number"
                  min="0"
                  name="newPriceChild"
                  value=(typeof tour !== "undefined" && tour) ? tour.newPriceChild : ""
                  placeholder="0"
                )


              .admin-form-group
                label(for="newPriceInfant") Em bé

                input#newPriceInfant.admin-input(
                  type="number"
                  min="0"
                  name="newPriceInfant"
                  value=(typeof tour !== "undefined" && tour) ? tour.newPriceInfant : ""
                  placeholder="0"
                )


          .admin-form-group

            label Còn lại

            .admin-form-row

              .admin-form-group
                label.admin-label-sm(for="remainingAdult") Người lớn

                input#remainingAdult.admin-input(
                  type="number"
                  min="0"
                  name="remainingAdult"
                  value=(typeof tour !== "undefined" && tour) ? tour.remainingAdult : ""
                  placeholder="0"
                )


              .admin-form-group
                label.admin-label-sm(for="remainingChild") Trẻ em

                input#remainingChild.admin-input(
                  type="number"
                  min="0"
                  name="remainingChild"
                  value=(typeof tour !== "undefined" && tour) ? tour.remainingChild : ""
                  placeholder="0"
                )


              .admin-form-group
                label.admin-label-sm(for="remainingInfant") Em bé

                input#remainingInfant.admin-input(
                  type="number"
                  min="0"
                  name="remainingInfant"
                  value=(typeof tour !== "undefined" && tour) ? tour.remainingInfant : ""
                  placeholder="0"
                )


          .admin-form-group

            label Những địa điểm có tour

            .admin-checkbox-group

              if typeof locationOptions !== "undefined" && locationOptions.length

                each loc in locationOptions

                  label.admin-checkbox-inline

                    input(
                      type="checkbox"
                      name="locations"
                      value=loc.value
                      checked=(typeof tour !== "undefined" && tour && tour.locations && tour.locations.includes(loc.value))
                    )

                    span= loc.label

              else

                label.admin-checkbox-inline
                  input(
                    type="checkbox"
                    name="locations"
                    value="cao-bang"
                    checked=(typeof tour !== "undefined" && tour && tour.locations && tour.locations.includes("cao-bang"))
                  )
                  span Cao Bằng


                label.admin-checkbox-inline
                  input(
                    type="checkbox"
                    name="locations"
                    value="son-la"
                    checked=(typeof tour !== "undefined" && tour && tour.locations && tour.locations.includes("son-la"))
                  )
                  span Sơn La


                label.admin-checkbox-inline
                  input(
                    type="checkbox"
                    name="locations"
                    value="lai-chau"
                    checked=(typeof tour !== "undefined" && tour && tour.locations && tour.locations.includes("lai-chau"))
                  )
                  span Lai Châu


                label.admin-checkbox-inline
                  input(
                    type="checkbox"
                    name="locations"
                    value="lang-son"
                    checked=(typeof tour !== "undefined" && tour && tour.locations && tour.locations.includes("lang-son"))
                  )
                  span Lạng Sơn


                label.admin-checkbox-inline
                  input(
                    type="checkbox"
                    name="locations"
                    value="tuyen-quang"
